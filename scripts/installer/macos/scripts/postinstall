#!/bin/bash
# Moves the staged Tanghim .amxd devices and the MTS-ESP-Max-Package from the
# package payload (/tmp/tanghim-m4l-staging) to:
#   - Ableton user library  → ~/Music/Ableton/User Library/.../Tanghim/
#   - Max Packages folder   → ~/Documents/Max 8/Packages/ and ~/Documents/Max 9/Packages/
#
# Invoked by productbuild when the M4L component is selected.
# productbuild runs this as root, so we detect the real console user via stat.

set -euo pipefail

STAGING_DIR="/tmp/tanghim-m4l-staging"
LEGACY_AMXD_NAME="Tanghim Receiver.amxd"
MAX_PACKAGE_NAME="MTS-ESP-Max-Package"

if ! compgen -G "${STAGING_DIR}/*.amxd" >/dev/null; then
    echo "postinstall: no staged .amxd files found in ${STAGING_DIR}" >&2
    exit 1
fi

if [[ ! -d "${STAGING_DIR}/${MAX_PACKAGE_NAME}" ]]; then
    echo "postinstall: staged ${MAX_PACKAGE_NAME} not found in ${STAGING_DIR}" >&2
    exit 1
fi

CONSOLE_USER="$(stat -f '%Su' /dev/console)"
if [[ -z "${CONSOLE_USER}" || "${CONSOLE_USER}" == "root" ]]; then
    echo "postinstall: could not determine console user (got '${CONSOLE_USER}')" >&2
    exit 1
fi

USER_HOME="$(dscl . -read "/Users/${CONSOLE_USER}" NFSHomeDirectory | awk '{print $2}')"
if [[ -z "${USER_HOME}" ]]; then
    echo "postinstall: could not read home directory for user '${CONSOLE_USER}'" >&2
    exit 1
fi

# ── Ableton User Library: install .amxd devices ──────────────────────────────
ABLETON_DEST="${USER_HOME}/Music/Ableton/User Library/Presets/MIDI Effects/Max MIDI Effect/Tanghim"
mkdir -p "${ABLETON_DEST}"

# Remove legacy combined device from prior installs (superseded by MPE + Mono PB).
rm -f "${ABLETON_DEST}/${LEGACY_AMXD_NAME}"

for staged_file in "${STAGING_DIR}"/*.amxd; do
    cp -f "${staged_file}" "${ABLETON_DEST}/"
done

chown -R "${CONSOLE_USER}" "${ABLETON_DEST}"

# ── Max Packages folder: install MTS-ESP-Max-Package to Max 8 and Max 9 ──────
# Live 11 → Max 8, Live 12 → Max 9. Install to both — harmless if one isn't used.
# Canonical location is the Max **Packages** folder, NOT Library:
#   ~/Documents/Max <N>/Packages/<PackageName>/
# Packages/ is Max's structured-package search path (externals/, init/, help/,
# package-info.json get registered); Library/ is a flat catch-all that only
# happened to resolve the .mxo on macOS and errors on Windows. Frozen .amxd
# loads only find the package's externals here (a standalone external next to
# the .amxd does not work). See docs.cycling74.com "About Packages".
for MAX_VERSION in "Max 8" "Max 9"; do
    MAX_PKGS="${USER_HOME}/Documents/${MAX_VERSION}/Packages"
    mkdir -p "${MAX_PKGS}"
    rm -rf "${MAX_PKGS}/${MAX_PACKAGE_NAME}"
    # Remove the stale copy prior installs placed in Library/ (wrong location).
    rm -rf "${USER_HOME}/Documents/${MAX_VERSION}/Library/${MAX_PACKAGE_NAME}"
    cp -R "${STAGING_DIR}/${MAX_PACKAGE_NAME}" "${MAX_PKGS}/"
    chown -R "${CONSOLE_USER}" "${USER_HOME}/Documents/${MAX_VERSION}"
done

# ── Cleanup staging ──────────────────────────────────────────────────────────
rm -rf "${STAGING_DIR}/${MAX_PACKAGE_NAME}"
rm -f "${STAGING_DIR}"/*.amxd

exit 0
