---
// Showcase.astro — full-width feature block: big centered visual + centered copy
// Props:
//   title:    string — shown verbatim (HTML: use ** around the gold-accented word in the parent)
//   subtitle: string
//   image:    string — public path e.g. "/shot-sliders.png"
//   imageAlt: string
//   reverse?: boolean — reserved for future use; layout is always centered

import { viewFullSizeLabel } from '../lib/lightboxLabels';

interface Props {
  title: string;
  subtitle: string;
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
  id?: string;
}

const { title, subtitle, image, imageAlt, id } = Astro.props;
const viewFullSize = viewFullSizeLabel(Astro.url.pathname);
---

<div class="page-band py-16 px-6 border-t border-[color-mix(in_srgb,var(--brand-muted)_10%,transparent)]" id={id}>
  <div class="showcase-inner reveal max-w-[860px] mx-auto flex flex-col items-center gap-10 text-center">
    <!-- Copy -->
    <div class="flex flex-col items-center gap-[0.875rem]">
      <h2 class="showcase-title m-0 font-bold leading-[1.2] tracking-[-0.015em] text-[var(--brand-text)] text-[clamp(1.5rem,3.5vw,2.25rem)] text-balance" set:html={title} />
      <p class="showcase-subtitle m-0 text-[clamp(0.9375rem,2vw,1.0625rem)] text-[var(--brand-muted)] leading-[1.5] max-w-[60ch]">{subtitle}</p>
      <div class="showcase-body text-[0.9375rem] leading-[1.7] flex flex-col gap-[0.625rem] items-center max-w-[60ch]">
        <slot />
      </div>
    </div>

    {/* Visual with soft gold glow — only when an image is provided */}
    {image && (
      <div class="relative w-full max-w-[820px]">
        <div class="showcase-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
        <button type="button" class="lightbox-trigger" data-lightbox aria-label={viewFullSize}>
          <img
            src={image}
            alt={imageAlt}
            class="block w-full h-auto rounded-[0.5rem] border border-[color-mix(in_srgb,var(--brand-gold)_18%,transparent)]"
            loading="lazy"
            decoding="async"
          />
        </button>
      </div>
    )}
  </div>
</div>

<style>
  /* Gold accent word in set:html title */
  .showcase-title :global(strong) {
    color: var(--brand-gold);
    font-weight: inherit;
  }

  /* Slotted body text color and p constraints */
  .showcase-body {
    color: color-mix(in srgb, var(--brand-text) 80%, var(--brand-muted));
  }

  .showcase-body :global(p) {
    margin: 0;
    max-width: 58ch;
  }

  /* badge-row in slotted content */
  .showcase-body :global(.badge-row) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.25rem;
  }

  /* Glow ellipse behind visual */
  .showcase-glow {
    inset: -12% -8%;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      color-mix(in srgb, var(--brand-gold) 15%, transparent) 0%,
      color-mix(in srgb, var(--brand-gold) 5%, transparent) 45%,
      transparent 70%
    );
  }

  /* Image shadow */
  .showcase-glow + img {
    box-shadow:
      0 4px 32px rgba(0, 0, 0, 0.45),
      0 0 48px color-mix(in srgb, var(--brand-gold) 6%, transparent);
  }

  /* Scroll reveal is handled by the global .reveal / .is-visible mechanism
     (IntersectionObserver in index.astro) — no animation-timeline needed here. */
</style>
