---
// Footer.astro — site footer
---
<footer class="bg-[var(--brand-navy-800)] pt-12 pb-8 px-6 border-t border-[color-mix(in_srgb,var(--brand-gold)_15%,transparent)]">
  <div class="max-w-[1200px] mx-auto flex flex-col gap-10">
    <!-- Link groups -->
    <div class="flex gap-12 flex-wrap">
      <div class="flex flex-col gap-2">
        <span class="text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-[var(--brand-muted)] mb-1">Documentation</span>
        <a href="/docs" class="footer-link text-[var(--brand-muted)] no-underline text-[0.9rem] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)]">Docs</a>
        <a href="/articles/cross-platform" class="footer-link text-[var(--brand-muted)] no-underline text-[0.9rem] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)]">Article</a>
      </div>

      <div class="flex flex-col gap-2">
        <span class="text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-[var(--brand-muted)] mb-1">Project</span>
        <a href="https://github.com/Music-Intelligence-Lab/tanghim" class="footer-link text-[var(--brand-muted)] no-underline text-[0.9rem] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)]" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://github.com/Music-Intelligence-Lab/tanghim/releases" class="footer-link text-[var(--brand-muted)] no-underline text-[0.9rem] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)]" target="_blank" rel="noopener noreferrer">Releases</a>
      </div>

      <div class="flex flex-col gap-2">
        <span class="text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-[var(--brand-muted)] mb-1">External</span>
        <a href="https://diarmaqar.net" class="footer-link text-[var(--brand-muted)] no-underline text-[0.9rem] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)]" target="_blank" rel="noopener noreferrer">DiArMaqAr</a>
        <a href="https://khyamallami.com" class="footer-link text-[var(--brand-muted)] no-underline text-[0.9rem] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)]" target="_blank" rel="noopener noreferrer">khyamallami.com</a>
      </div>
    </div>

    <!-- Credit + open source -->
    <div class="border-t border-[color-mix(in_srgb,var(--brand-muted)_15%,transparent)] pt-6 flex flex-col gap-3">
      <p class="text-[0.85rem] text-[var(--brand-muted)] m-0 leading-[1.6]">
        Conceived and designed by Khyam Allami · Music Intelligence Lab, AUB (2026).
        Open source — <a href="https://github.com/Music-Intelligence-Lab/tanghim" class="footer-link text-[var(--brand-muted)] underline underline-offset-[2px] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)]" target="_blank" rel="noopener noreferrer">view on GitHub</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link:focus-visible {
    outline: 2px solid var(--brand-gold);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
