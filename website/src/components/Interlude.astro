---
// Interlude.astro — editorial "margin gloss" aside between showcase blocks.
//
// A reusable lexicon-entry treatment: a large Arabic display glyph set like an
// illuminated initial in its own column, an eyebrow category label, and the
// gloss prose at reading measure to the right — left-aligned to break the
// centered hero/showcase rhythm. Designed to be dropped in several times
// (name gloss, and more to come) with different glyph + eyebrow + body.
//
// Props:
//   eyebrow:      string — small gold category label (e.g. "On the name")
//   glyph?:       string — Arabic display word set large (e.g. "تنغيم"); omit for text-only interludes
//   glyphRoman?:  string — optional roman transliteration shown under the glyph
//   body slot:    the gloss prose (HTML allowed)

interface Props {
  eyebrow?: string;
  glyph?: string;
  expandable?: boolean;
  /** Localised toggle labels; required when expandable. */
  expandLabel?: string;
  collapseLabel?: string;
}

const { eyebrow, glyph, expandable = false, expandLabel = 'Expand', collapseLabel = 'Collapse' } = Astro.props;

// Expandable only applies to no-glyph explainer interludes.
const isExpandable = expandable && !glyph;

// Stable unique id for aria-controls (crypto.randomUUID is available at build time in Astro/Node).
const bodyId = `interlude-body-${crypto.randomUUID().slice(0, 8)}`;
---

<div class:list={['interlude-inner reveal', { 'interlude-inner--no-glyph': !glyph, 'interlude-inner--expandable': isExpandable }]}>
  {glyph && (
    <div class="interlude-glyph" aria-hidden="true">
      <span lang="ar" class="interlude-glyph-word">{glyph}</span>
    </div>
  )}
  {isExpandable ? (
    <div class="interlude-text interlude-text--expandable">
      <span class="interlude-accent-line" aria-hidden="true"></span>
      {eyebrow && <h2 class="interlude-title">{eyebrow}</h2>}
      <div id={bodyId} class="interlude-collapse">
        <div class="interlude-body interlude-body--centered">
          <slot />
        </div>
      </div>
      <button
        type="button"
        class="interlude-toggle"
        aria-expanded="false"
        aria-controls={bodyId}
        aria-label={expandLabel}
        data-expand-label={expandLabel}
        data-collapse-label={collapseLabel}
      >
        <span class="interlude-chevron" aria-hidden="true"></span>
      </button>
    </div>
  ) : (
    <div class="interlude-text">
      {eyebrow && <p class="interlude-eyebrow">{eyebrow}</p>}
      <div class="interlude-body">
        <slot />
      </div>
    </div>
  )}
</div>

<style>
  .interlude-inner {
    max-width: 940px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 2.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  /* Text-only interludes (no Arabic glyph) — a single reading column with a
     gold rule at its left edge, marking it as an explainer aside rather than a
     lexical gloss. Used by the "what is X?" strips (MTS-ESP, DiArMaqAr). */
  .interlude-inner--no-glyph {
    grid-template-columns: minmax(0, 1fr);
    max-width: 760px;
  }

  .interlude-inner--no-glyph .interlude-text {
    /* Logical props so the gold rule sits on the inline-start edge in both
       directions (left under LTR, right under RTL). */
    border-inline-start: 2px solid color-mix(in srgb, var(--brand-gold) 40%, transparent);
    padding-inline-start: clamp(1.25rem, 3vw, 2rem);
  }

  /* Illuminated-initial glyph column */
  .interlude-glyph {
    display: flex;
    flex-direction: column;
    /* flex-end + text-align:end are direction-aware: the glyph hugs the text
       column (its right in LTR, its left in RTL). */
    align-items: flex-end;
    text-align: end;
  }

  .interlude-glyph-word {
    font-family: var(--font-arabic-display);
    font-weight: 700;
    font-size: clamp(3.25rem, 9vw, 5.5rem);
    line-height: 0.95;
    color: var(--brand-gold);
    /* Very soft glow so the glyph reads as illuminated, not flat */
    text-shadow: 0 0 32px color-mix(in srgb, var(--brand-gold) 22%, transparent);
  }

  /* Eyebrow — the lexicon category */
  .interlude-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--brand-gold);
  }

  /* Arabic script must never be letter-spaced — positive tracking breaks the
     cursive joins. Neutralise the eyebrow tracking under any RTL root. */
  :global([dir='rtl']) .interlude-eyebrow {
    letter-spacing: normal;
  }

  .interlude-text {
    padding-inline-start: clamp(1rem, 2.5vw, 1.75rem);
  }

  .interlude-body {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.85;
    color: var(--brand-muted);
    max-width: 62ch;
  }

  .interlude-body :global(p) {
    margin: 0;
  }

  .interlude-body :global(.interlude-link) {
    color: color-mix(in srgb, var(--brand-text) 78%, var(--brand-muted));
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--brand-gold) 50%, transparent);
    text-underline-offset: 2px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .interlude-body :global(.interlude-link:hover) {
    color: var(--brand-text);
    text-decoration-color: var(--brand-gold);
  }

  .interlude-body :global(.interlude-link:focus-visible) {
    outline: 2px solid var(--brand-gold);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .interlude-body :global(p + p) {
    margin-top: 0.9rem;
  }

  /* Arabic inline terms in the prose pick up the display face + gold tint */
  .interlude-body :global([lang='ar']) {
    font-family: var(--font-arabic-display);
    color: color-mix(in srgb, var(--brand-gold) 80%, var(--brand-text));
    font-size: 1.08em;
  }

  .interlude-body :global(strong.accent),
  .interlude-body :global(strong) {
    color: var(--brand-text);
    font-weight: 600;
  }

  /* Term highlight: a brighter tint that lifts an introduced term out of the
     muted body. Upright (no italic) so it reads consistently across scripts —
     Arabic has no italic form, so LTR and RTL now match. */
  .interlude-body :global(em) {
    color: color-mix(in srgb, var(--brand-text) 78%, var(--brand-muted));
    font-style: normal;
  }

  /* Arabic has no italic form — the synthesised slant breaks cursive joins.
     Under RTL, emphasise with an upright gold tint instead. */
  :global([dir='rtl']) .interlude-body :global(em) {
    font-style: normal;
    color: color-mix(in srgb, var(--brand-gold) 80%, var(--brand-text));
  }

  @media (max-width: 720px) {
    .interlude-inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .interlude-glyph {
      align-items: flex-start;
      text-align: start;
    }
    .interlude-text {
      padding-inline-start: 0;
    }
  }

  /* ── Expandable "What is X?" interludes ─────────────────────────────────
     Centered, symmetric explainer: short gold accent line, eyebrow-as-title,
     center-justified body clamped to 1 line until expanded, chevron toggle.
     Replaces the left gold rule (which doesn't suit centered content). */
  .interlude-inner--expandable {
    grid-template-columns: minmax(0, 1fr);
    max-width: 720px;
    text-align: center;
  }

  /* No left rule on the expandable variant — the no-glyph border rule must not
     apply here. */
  .interlude-inner--expandable .interlude-text--expandable {
    border-inline-start: none;
    padding-inline-start: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .interlude-accent-line {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-bottom: 0.6rem;
    background: color-mix(in srgb, var(--brand-gold) 55%, transparent);
    border-radius: 1px;
  }

  .interlude-title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brand-gold);
    line-height: 1.3;
  }

  /* Arabic titles must not be letter-spaced (breaks cursive joins). */
  :global([dir='rtl']) .interlude-title {
    letter-spacing: normal;
    text-transform: none;
  }

  .interlude-body--centered {
    text-align: center;
    margin-inline: auto;
  }

  /* Collapsed: clamp the body to 1 line with an ellipsis. The collapse wrapper
     animates in Task 3; here it just holds the clamp. */
  .interlude-collapse .interlude-body--centered {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  /* Toggle button */
  .interlude-toggle {
    margin-top: 0.6rem;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--brand-gold) 55%, transparent);
    border-radius: 50%;
    background: transparent;
    color: var(--brand-gold);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .interlude-toggle:hover {
    background: color-mix(in srgb, var(--brand-gold) 12%, transparent);
    border-color: var(--brand-gold);
  }

  .interlude-toggle:focus-visible {
    outline: 2px solid var(--brand-gold);
    outline-offset: 2px;
  }

  /* Plus/minus toggle glyph. `+` when collapsed, `−` when expanded. */
  .interlude-chevron {
    display: inline-block;
    font-size: 1.25rem;
    line-height: 1;
  }

  .interlude-chevron::before {
    content: '+';
  }

  /* ── Expand/collapse animation ──────────────────────────────────────────
     Default (no JS): fully expanded, no clamp, button hidden — so text is
     never trapped. The .js-ready gate below re-enables the collapsed state. */
  .interlude-toggle { display: none; }

  :global(body.js-ready) .interlude-toggle { display: inline-flex; }

  /* With JS: the collapse wrapper uses a max-height transition. Collapsed =
     a 1-line max-height floor; open = a generous max-height. max-height is
     used (not grid 1fr) because it eases reliably from a fixed floor. */
  :global(body.js-ready) .interlude-collapse {
    max-height: calc(1em * 1.85 + 0.1em); /* ~1 line at the body line-height */
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  :global(body.js-ready) .interlude-inner--expandable.is-open .interlude-collapse {
    max-height: 40rem; /* larger than any interlude body; eases open */
  }

  /* Release the line-clamp when open so the full prose shows. */
  :global(body.js-ready) .interlude-inner--expandable.is-open .interlude-collapse .interlude-body--centered {
    -webkit-line-clamp: unset;
    display: block;
    overflow: visible;
  }

  /* Minus glyph when open. */
  :global(body.js-ready) .interlude-inner--expandable.is-open .interlude-chevron::before {
    content: '−'; /* U+2212 minus sign */
  }

  /* Reduced motion: no transition, and show everything expanded with no toggle. */
  @media (prefers-reduced-motion: reduce) {
    :global(body.js-ready) .interlude-collapse { transition: none; max-height: none; }
    :global(body.js-ready) .interlude-collapse .interlude-body--centered {
      -webkit-line-clamp: unset; display: block; overflow: visible;
    }
    :global(body.js-ready) .interlude-toggle { display: none; }
  }
</style>

<script>
  // Expandable interludes: wire each toggle to its aria-controls target.
  // Runs only when JS is active; CSS above keeps content visible without it.
  document.addEventListener('DOMContentLoaded', () => {
    const toggles = document.querySelectorAll('.interlude-toggle');
    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const inner = btn.closest('.interlude-inner--expandable');
        if (!inner) return;
        const open = inner.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        const expandLabel = btn.getAttribute('data-expand-label') || 'Expand';
        const collapseLabel = btn.getAttribute('data-collapse-label') || 'Collapse';
        btn.setAttribute('aria-label', open ? collapseLabel : expandLabel);
      });
    });
  });
</script>
