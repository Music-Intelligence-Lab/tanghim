---
// FeatureGrid.astro — compact card grid from an items array
// Props:
//   items: Array<{
//     title: string;
//     body:  string;
//     badge?: 'mts' | 'mpe' | 'monopb' | 'osc' | 'hept';
//   }>
import Badge from './Badge.astro';

interface GridItem {
  title: string;
  body: string;
  badge?: 'mts' | 'mpe' | 'monopb' | 'osc' | 'hept';
}

interface Props {
  items: GridItem[];
}

const { items } = Astro.props;
---

<div class="feature-grid-wrap">
  <ul class="feature-grid" role="list">
    {items.map((item) => (
      <li class="grid-card">
        <span class="card-accent" aria-hidden="true">▸</span>
        <div class="card-content">
          <div class="card-header">
            <span class="card-title">{item.title}</span>
            {item.badge && (
              <Badge variant={item.badge}>{item.badge === 'mts' ? 'MTS-ESP' : item.badge === 'mpe' ? 'MPE' : item.badge === 'monopb' ? 'Mono PB' : item.badge === 'osc' ? 'Osc' : 'Hept'}</Badge>
            )}
          </div>
          <p class="card-body">{item.body}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .feature-grid-wrap {
    padding: 3.5rem 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--brand-muted) 10%, transparent);
  }

  .feature-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1040px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background-color: color-mix(in srgb, var(--brand-muted) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-muted) 10%, transparent);
    border-radius: 0.625rem;
    overflow: hidden;
  }

  .grid-card {
    display: flex;
    gap: 0.875rem;
    padding: 1.5rem 1.75rem;
    background-color: color-mix(in srgb, var(--brand-navy-800) 60%, var(--brand-navy-900));
    transition: background-color 0.15s ease;
  }

  .grid-card:hover {
    background-color: color-mix(in srgb, var(--brand-navy-700) 50%, var(--brand-navy-800));
  }

  .card-accent {
    flex-shrink: 0;
    margin-top: 0.125rem;
    font-size: 0.625rem;
    color: var(--brand-gold);
    line-height: 1.6;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--brand-text);
    line-height: 1.3;
  }

  .card-body {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--brand-muted);
  }

  /* 1-column on mobile */
  @media (max-width: 600px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
