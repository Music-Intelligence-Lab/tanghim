---
// FeatureRow.astro — two-column: text + visual side by side; reverse flips the order
// Props:
//   title:    string (HTML with <strong> for gold accent)
//   image:    string — public path
//   imageAlt: string
//   reverse?: boolean — flip text/visual columns

interface Props {
  title: string;
  image: string;
  imageAlt: string;
  reverse?: boolean;
}

const { title, image, imageAlt, reverse = false } = Astro.props;
---

<div class:list={['feature-row', { 'feature-row--reverse': reverse }]}>
  <div class="feature-row-inner">
    <!-- Text column -->
    <div class="feature-row-text">
      <h3 class="row-title" set:html={title} />
      <div class="row-body">
        <slot />
      </div>
    </div>

    <!-- Visual column -->
    <div class="feature-row-visual">
      <div class="row-glow" aria-hidden="true"></div>
      <img
        src={image}
        alt={imageAlt}
        class="row-img"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>

<style>
  .feature-row {
    padding: 3.5rem 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--brand-muted) 10%, transparent);
  }

  .feature-row-inner {
    max-width: 1040px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* Reverse: visual first, text second */
  .feature-row--reverse .feature-row-inner {
    direction: rtl;
  }

  .feature-row--reverse .feature-row-inner > * {
    direction: ltr;
  }

  /* Text column */
  .feature-row-text {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .row-title {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--brand-text);
  }

  .row-title :global(strong) {
    color: var(--brand-gold);
    font-weight: inherit;
  }

  .row-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--brand-text) 75%, var(--brand-muted));
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .row-body :global(p) {
    margin: 0;
  }

  /* Visual column */
  .feature-row-visual {
    position: relative;
  }

  .row-glow {
    position: absolute;
    inset: -15% -10%;
    background: radial-gradient(
      ellipse 70% 65% at 50% 50%,
      color-mix(in srgb, var(--brand-gold) 12%, transparent) 0%,
      color-mix(in srgb, var(--brand-gold) 4%, transparent) 45%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .row-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--brand-gold) 15%, transparent);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.4),
      0 0 36px color-mix(in srgb, var(--brand-gold) 5%, transparent);
  }

  /* Stack on narrow viewports */
  @media (max-width: 720px) {
    .feature-row-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .feature-row--reverse .feature-row-inner {
      direction: ltr;
    }
  }

  /* Scroll reveal — disabled under reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .feature-row-inner {
      animation: row-reveal 0.5s ease both;
      animation-timeline: view();
      animation-range: entry 0% entry 30%;
    }
  }

  @keyframes row-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
