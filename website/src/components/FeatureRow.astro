---
// FeatureRow.astro — two-column: text + visual side by side; reverse flips the order
// Props:
//   title:    string (HTML with <strong> for gold accent)
//   image:    string — public path
//   imageAlt: string
//   reverse?: boolean — flip text/visual columns

import { viewFullSizeLabel } from '../lib/lightboxLabels';

interface Props {
  title: string;
  image: string;
  imageAlt: string;
  reverse?: boolean;
}

const { title, image, imageAlt, reverse = false } = Astro.props;
const viewFullSize = viewFullSizeLabel(Astro.url.pathname);
---

<div class:list={['feature-row page-band py-14 px-6 border-t border-[color-mix(in_srgb,var(--brand-muted)_10%,transparent)]', { 'feature-row--reverse': reverse }]}>
  <div class="feature-row-inner reveal max-w-[1040px] mx-auto grid grid-cols-2 gap-12 items-center max-[720px]:grid-cols-1 max-[720px]:gap-8">
    <!-- Text column -->
    <div class="flex flex-col gap-[0.875rem]">
      <h3 class="row-title m-0 font-bold leading-[1.25] tracking-[-0.01em] text-[var(--brand-text)] text-[clamp(1.25rem,2.5vw,1.75rem)]" set:html={title} />
      <div class="row-body text-[0.9375rem] leading-[1.7] flex flex-col gap-2">
        <slot />
      </div>
    </div>

    <!-- Visual column -->
    <div class="feature-row-visual relative">
      <div class="row-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
      <button type="button" class="lightbox-trigger" data-lightbox aria-label={viewFullSize}>
        <img
          src={image}
          alt={imageAlt}
          class="block w-full h-auto rounded-[0.5rem] border border-[color-mix(in_srgb,var(--brand-gold)_15%,transparent)]"
          loading="lazy"
          decoding="async"
        />
      </button>
    </div>
  </div>
</div>

<style>
  /* Reverse layout: pull the visual into the inline-start column. `order`
     reorders within the grid's own writing direction, so the flip is correct
     under both LTR (visual→left) and RTL (visual→right) without a `direction`
     override — slotted text therefore keeps the page's direction. Only reorder
     at ≥2 columns; on mobile the single column keeps DOM order (text, then
     visual). */
  @media (min-width: 721px) {
    .feature-row--reverse .feature-row-visual {
      order: -1;
    }
  }

  /* Row title strong — gold accent from set:html content */
  .row-title :global(strong) {
    color: var(--brand-gold);
    font-weight: inherit;
  }

  /* Row body text color and p margin from slotted content */
  .row-body {
    color: color-mix(in srgb, var(--brand-text) 75%, var(--brand-muted));
  }

  .row-body :global(p) {
    margin: 0;
  }

  /* Glow behind the image */
  .row-glow {
    inset: -15% -10%;
    background: radial-gradient(
      ellipse 70% 65% at 50% 50%,
      color-mix(in srgb, var(--brand-gold) 12%, transparent) 0%,
      color-mix(in srgb, var(--brand-gold) 4%, transparent) 45%,
      transparent 70%
    );
  }

  /* Image shadow */
  .feature-row-visual img {
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.4),
      0 0 36px color-mix(in srgb, var(--brand-gold) 5%, transparent);
  }

  /* Scroll reveal is handled by the global .reveal / .is-visible mechanism
     (IntersectionObserver in index.astro) — no animation-timeline needed here. */
</style>
