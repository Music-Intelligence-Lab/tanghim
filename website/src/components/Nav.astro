---
// Nav.astro — sticky top navigation
---
<nav class="sticky top-0 z-[100] bg-[var(--brand-navy-900)] border-b border-[color-mix(in_srgb,var(--brand-gold)_20%,transparent)]" aria-label="Main navigation">
  <div class="max-w-[1200px] mx-auto px-6 h-14 flex items-center justify-between">
    <!-- Wordmark -->
    <a href="/" class="text-[1.25rem] font-semibold text-[var(--brand-text)] no-underline tracking-[-0.01em] hover:text-[var(--brand-text)] accent" aria-label="Tanghīm home">
      Tangh<span class="text-[var(--brand-gold)]">ī</span>m
    </a>

    <!-- Mobile toggle -->
    <details class="hidden max-[720px]:block relative">
      <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer text-[var(--brand-text)] p-1 rounded-[0.25rem]" aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <rect y="4" width="22" height="2" rx="1" fill="currentColor"/>
          <rect y="10" width="22" height="2" rx="1" fill="currentColor"/>
          <rect y="16" width="22" height="2" rx="1" fill="currentColor"/>
        </svg>
      </summary>
      <div class="absolute right-0 top-[calc(100%+0.5rem)] bg-[var(--brand-navy-800)] border border-[color-mix(in_srgb,var(--brand-gold)_20%,transparent)] rounded-[0.5rem] p-2 min-w-[180px] flex flex-col gap-[0.125rem]">
        <a href="/#features" class="block text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-2 rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]">Features</a>
        <a href="/docs" class="block text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-2 rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]">Docs</a>
        <a href="/articles/cross-platform" class="block text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-2 rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]">Article</a>
        <a href="https://github.com/Music-Intelligence-Lab/tanghim" class="block text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-2 rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/#download" class="block mt-1 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] font-semibold text-[0.875rem] px-3 py-2 rounded-[0.375rem] no-underline text-center">Download</a>
      </div>
    </details>

    <!-- Desktop links -->
    <div class="flex items-center gap-1 max-[720px]:hidden">
      <a href="/#features" class="text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-[0.4rem] rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]">Features</a>
      <a href="/docs" class="text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-[0.4rem] rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]">Docs</a>
      <a href="/articles/cross-platform" class="text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-[0.4rem] rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]">Article</a>
      <a href="https://github.com/Music-Intelligence-Lab/tanghim" class="text-[var(--brand-muted)] no-underline text-[0.9rem] px-3 py-[0.4rem] rounded-[0.375rem] transition-colors duration-150 hover:text-[var(--brand-text)]" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/#download" class="ml-2 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] font-semibold text-[0.875rem] px-4 py-[0.4rem] rounded-[0.375rem] no-underline transition-opacity duration-150 hover:opacity-90">Download</a>
    </div>
  </div>
</nav>
