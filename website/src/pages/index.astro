---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import Badge from '../components/Badge.astro';
import Showcase from '../components/Showcase.astro';
import FeatureRow from '../components/FeatureRow.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tanghīm — Arabic Maqām Tuning for Any DAW</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content="Tanghīm is an open-source Arabic maqām tuning plugin for any DAW — load a maqām, adjust every degree by ear, and tune your instruments via MTS-ESP, MPE, or Mono Pitch Bend." />
    <link rel="canonical" href="https://tanghim.app/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tanghim.app/" />
    <meta property="og:title" content="Tanghīm — Arabic Maqām Tuning for Any DAW" />
    <meta property="og:description" content="Tanghīm is an open-source Arabic maqām tuning plugin for any DAW — load a maqām, adjust every degree by ear, and tune your instruments via MTS-ESP, MPE, or Mono Pitch Bend." />
    <meta property="og:image" content="https://tanghim.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Tanghīm plugin interface showing maqām tuning sliders on a navy panel." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tanghīm — Arabic Maqām Tuning for Any DAW" />
    <meta name="twitter:description" content="Tanghīm is an open-source Arabic maqām tuning plugin for any DAW — load a maqām, adjust every degree by ear, and tune your instruments via MTS-ESP, MPE, or Mono Pitch Bend." />
    <meta name="twitter:image" content="https://tanghim.app/og-image.png" />
    <meta name="twitter:image:alt" content="The Tanghīm plugin interface showing maqām tuning sliders on a navy panel." />

  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- JS-gate: only hide .reveal elements when JS is running.
         Without this class, all .reveal elements remain fully visible (no-JS safe). -->
    <script is:inline>document.body.classList.add('js-ready');</script>

    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Nav />

    <main class="flex-1" id="main-content">

      <!-- ═══════════════════════════════════════════
           HERO
           ═══════════════════════════════════════════ -->
      <section class="pt-20 pb-16 px-6 max-[600px]:pt-14 max-[600px]:pb-12 max-[600px]:px-5" aria-label="Introduction">
        <div class="hero-inner max-w-[860px] mx-auto flex flex-col items-center gap-11 text-center max-[600px]:gap-8">

          <!-- Text block -->
          <div class="flex flex-col items-center gap-5">
            <p class="m-0 text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-[var(--brand-muted)]">Arabic Maqām Tuning</p>

            <h1 class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.15] tracking-[-0.02em] text-[var(--brand-text)] max-w-[18ch] text-balance">
              Play Arabic maqām with the <span class="text-[var(--brand-gold)]">intonation</span> it was written for.
            </h1>

            <p class="m-0 text-[clamp(1rem,2.2vw,1.125rem)] leading-[1.65] text-[var(--brand-muted)] max-w-[60ch] text-balance">
              An open-source plugin that brings maqām tuning systems to any DAW — and lets you adjust every degree by ear.
            </p>

            <!-- CTAs -->
            <div class="flex gap-[0.875rem] flex-wrap justify-center items-center mt-1 max-[600px]:gap-[0.625rem]">
              <a href="#download" class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Download</a>
              <a href="/docs" class="cta-secondary inline-block py-[0.65rem] px-4 text-[var(--brand-muted)] text-[0.9375rem] font-medium no-underline rounded-[0.375rem] border border-[color-mix(in_srgb,var(--brand-muted)_30%,transparent)] transition-[color,border-color] duration-150 ease-[ease] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Read the docs</a>
            </div>
          </div>

          <!-- UI screenshot with gold glow -->
          <div class="relative w-full max-w-[820px]">
            <div class="hero-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
            <img
              src="/tanghim-ui.png"
              alt="The Tanghīm plugin interface: a bank of tuning sliders showing maqām degrees in gold against a navy panel, with maqām selector, preset grid, and reference-frequency controls."
              class="relative z-[1] block w-full h-auto rounded-[0.625rem] border border-[color-mix(in_srgb,var(--brand-gold)_22%,transparent)]"
              width="1756"
              height="1370"
              loading="eager"
            />
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           TRUST / CONTEXT STRIP
           ═══════════════════════════════════════════ -->
      <section class="trust-strip reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] pt-10 pb-12 px-6" aria-label="Context and compatibility">
        <div class="max-w-[860px] mx-auto flex flex-col items-center gap-5 text-center">

          <!-- Origin -->
          <p class="m-0 text-[0.8rem] text-[var(--brand-muted)] tracking-[0.02em]">
            Conceived and designed by Khyam Allami · Music Intelligence Lab, AUB
          </p>

          <!-- Name gloss -->
          <p class="m-0 text-[0.875rem] leading-[1.7] text-[var(--brand-muted)] max-w-[62ch] text-balance">
            <span class="accent">Tanghīm</span> (<span lang="ar">تنغيم</span>)
            is the singular of <span class="accent">tanāghīm</span> (<span lang="ar">تناغيم</span>),
            the tuning-systems layer of the <a href="https://diarmaqar.net" class="text-[var(--brand-muted)] underline underline-offset-[2px] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" target="_blank" rel="noopener noreferrer">DiArMaqAr</a> archive.
            It means both a tuning system and the act of tuning — an intonational tuning, not the <span class="accent">dūzān</span> (<span lang="ar">دوزان</span>) of setting an open string's pitch.
          </p>

          <!-- Compatibility badges -->
          <div class="flex flex-col items-center gap-3 pt-1">
            <span class="text-[0.825rem] text-[var(--brand-muted)] tracking-[0.01em]">Any DAW, any synth — three tuning methods:</span>
            <div class="badge-row flex gap-2 flex-wrap justify-center">
              <Badge variant="mts">MTS-ESP</Badge>
              <Badge variant="mpe">MPE</Badge>
              <Badge variant="monopb">Mono PB</Badge>
            </div>
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           FEATURE BODY
           ═══════════════════════════════════════════ -->
      <section id="features" aria-label="Features">

        <!-- Showcase 1: Slider Bank -->
        <Showcase
          title="Every degree, <strong>editable</strong>."
          subtitle="The tuning data is the starting point, not a cage."
          image="/shot-sliders.png"
          imageAlt="The Tanghīm slider bank: twelve per-chromatic-step sliders showing cents readouts, IPN labels, solfège, and PAO names, with gold-highlighted maqām degree thumbs."
        >
          <p>Twelve sliders — one per chromatic step — set the cents for each maqām degree. Tanghīm loads the archive's tuning, then lets you adjust any degree by ear; your edits are the source of truth for the frequency table.</p>
        </Showcase>

        <!-- Showcase 2: Tuning Methods -->
        <Showcase
          title="One tuning, <strong>three ways</strong> out."
          subtitle="Three output methods for a wide range of instruments."
          image="/shot-methods.png"
          imageAlt="The Tanghīm top control bar showing the tuning-system selector, reference-frequency knob, and the MTS-ESP, MPE, and Mono PB tuning-method status badges active."
        >
          <p>MTS-ESP retunes compatible synths automatically over shared memory. MPE sends per-note pitch bend across channels 2–16 for polyphonic instruments. Mono Pitch Bend drives ordinary single-channel synths. The top bar shows which are active.</p>
          <div class="badge-row">
            <Badge variant="mts">MTS-ESP</Badge>
            <Badge variant="mpe">MPE</Badge>
            <Badge variant="monopb">Mono PB</Badge>
          </div>
        </Showcase>

        <!-- Showcase 3: Maqam Selection & Presets -->
        <Showcase
          title="Pick a maqām, <strong>snap</strong> the scale."
          subtitle="Eight presets, mappable to MIDI."
          image="/shot-presets.png"
          imageAlt="The Tanghīm maqām selector showing 'maqām rāst' in the dropdown and the 4×2 preset grid with the first slot highlighted in gold as the active preset."
        >
          <p>Choose a maqām and transposition; the sliders snap to its intervals and the degrees highlight in gold. Save up to eight presets and switch between them live — including by MIDI note or Program Change.</p>
        </Showcase>

        <!-- Showcase 4: Oscillator & Heptatonic mode -->
        <Showcase
          title="Hear it <strong>instantly</strong>."
          subtitle="Audition tunings; play the scale on the white keys."
          image="/tanghim-ui.png"
          imageAlt="The full Tanghīm interface showing the Osc and Hept toggle badges active in the top-right corner alongside the tuning-method status indicators."
        >
          <p>The built-in triangle-wave oscillator (Osc) lets you hear a tuning with no external instrument loaded. Heptatonic mode (Hept) remaps the keyboard so the white keys play the maqām degrees in order from the tonic.</p>
          <div class="badge-row">
            <Badge variant="osc">Osc</Badge>
            <Badge variant="hept">Hept</Badge>
          </div>
        </Showcase>

        <!-- FeatureRow A: MIDI preset mapping -->
        <FeatureRow
          title="Switch maqāmat <strong>mid-performance</strong>."
          image="/shot-presets.png"
          imageAlt="The Tanghīm preset grid with eight slots showing named maqām presets ready for live MIDI switching."
        >
          <p>Map MIDI notes to presets through a dedicated input, so you can switch maqāmat mid-performance from a controller — reliable regardless of DAW routing.</p>
        </FeatureRow>

        <!-- FeatureRow B: MIDI export & .tanghim files (reversed) -->
        <FeatureRow
          title="Export the scale. <strong>Save</strong> the setup."
          image="/tanghim-ui.png"
          imageAlt="The Tanghīm interface showing the MIDI drag export button and the full tuning state ready to save as a .tanghim file."
          reverse
        >
          <p>Drag the current maqām scale out as a Standard MIDI File — with a Program Change embedded so the preset re-arms on playback. Save and reload full tuning setups as human-readable .tanghim files.</p>
        </FeatureRow>

        <!-- Feature Grid -->
        <FeatureGrid items={[
          {
            title: 'Per-note overrides',
            body: 'Give the same pitch class a different variant in a specific octave.',
          },
          {
            title: 'Reference frequency',
            body: "Set the tuning's base pitch by knob, exact Hz, or ±100-cent steps; it carries across system switches.",
          },
          {
            title: 'Range scroller',
            body: 'Pan the 128-note keyboard with magnetic snap to C, G, and A.',
          },
          {
            title: 'DAW automation',
            body: 'Slider cents, reference offset, and preset are exposed as automatable parameters.',
          },
          {
            title: 'Save & load',
            body: 'Store and recall complete tuning states as portable .tanghim files.',
          },
          {
            title: 'Program-change switching',
            body: 'Switch presets from your DAW with MIDI Program Change messages.',
          },
        ]} />

      </section>

      <!-- ═══════════════════════════════════════════
           ABLETON CALL-OUT
           ═══════════════════════════════════════════ -->
      <section class="ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="Ableton Live compatibility">
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2 class="m-0 text-[clamp(1.25rem,3vw,1.625rem)] font-bold text-[var(--brand-text)] tracking-[-0.01em] text-balance">Works in Ableton Live, too.</h2>
          <p class="m-0 text-[1rem] leading-[1.7] text-[var(--brand-muted)] max-w-[60ch] text-pretty">
            Ableton Live doesn't host third-party MIDI-effect plug-ins, so Tanghīm ships Max for Live receivers
            — an MPE Receiver and a Mono Pitch Bend Receiver — that deliver the tuning inside Live.
            No extra configuration; install, load, and the tuning follows.
          </p>
          <div class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]">
            <a href="/articles/cross-platform" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline">Read the full cross-platform story →</a>
            <a href="/docs/ableton" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline">Ableton Live setup guide →</a>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           FINAL CTA BAND
           DownloadButtons anchor (#download) lives here
           ═══════════════════════════════════════════ -->
      <section class="cta-band reveal border-t-2 border-[color-mix(in_srgb,var(--brand-gold)_35%,transparent)] py-20 px-6 bg-[var(--brand-navy-800)] max-[600px]:py-14 max-[600px]:px-5" aria-label="Download">
        <div class="max-w-[860px] mx-auto flex flex-col items-center gap-8 text-center">
          <h2 class="m-0 text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold text-[var(--brand-text)] tracking-[-0.02em] text-balance max-w-[24ch]">Free, open-source, and ready for your maqām.</h2>
          <DownloadButtons />
          <a href="/docs" class="cta-secondary inline-block mt-1 py-[0.65rem] px-4 text-[var(--brand-muted)] text-[0.9375rem] font-medium no-underline rounded-[0.375rem] border border-[color-mix(in_srgb,var(--brand-muted)_30%,transparent)] transition-[color,border-color] duration-150 ease-[ease] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Read the docs</a>
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>

<script>
  // Cross-browser scroll reveals via IntersectionObserver.
  // Requires body.js-ready (set by inline script above) — without it .reveal
  // elements are already fully visible, so no observer is needed.
  // Also skips entirely under prefers-reduced-motion (elements are visible via CSS).
  if (
    typeof IntersectionObserver !== 'undefined' &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target); // animate once only
          }
        }
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    // Ensure all reveals are visible if observer unavailable or motion reduced
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  /* Trust strip background — color-mix */
  .trust-strip {
    background-color: color-mix(in srgb, var(--brand-navy-800) 50%, var(--brand-navy-900));
  }

  /* Ableton callout background — color-mix */
  .ableton-callout {
    background-color: color-mix(in srgb, var(--brand-navy-800) 40%, var(--brand-navy-900));
  }

  /* CTA band bottom padding (pb-22 isn't a default Tailwind value) */
  .cta-band {
    padding-bottom: 5.5rem;
  }

  @media (max-width: 600px) {
    .cta-band {
      padding-bottom: 4rem;
    }
  }

  /* Hero glow radial gradient */
  .hero-glow {
    inset: -10% -8%;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      color-mix(in srgb, var(--brand-gold) 18%, transparent) 0%,
      color-mix(in srgb, var(--brand-gold) 6%, transparent) 45%,
      transparent 70%
    );
  }

  /* Hero screenshot shadow */
  .hero-glow + img {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--brand-navy-700) 60%, transparent),
      0 8px 40px rgba(0, 0, 0, 0.55),
      0 0 60px color-mix(in srgb, var(--brand-gold) 8%, transparent);
  }

  /* cta-secondary hover — border color-mix */
  .cta-secondary:hover {
    color: var(--brand-text);
    border-color: color-mix(in srgb, var(--brand-muted) 55%, transparent);
  }

  /* Hero fade/rise on load — disabled when reduced-motion preferred */
  @media (prefers-reduced-motion: no-preference) {
    .hero-inner {
      animation: hero-rise 0.6s ease both;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
