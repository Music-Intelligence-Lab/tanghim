---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import DownloadButtons from "../components/DownloadButtons.astro";
import Badge from "../components/Badge.astro";
import Showcase from "../components/Showcase.astro";
import FeatureRow from "../components/FeatureRow.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Interlude from "../components/Interlude.astro";
import Lightbox from "../components/Lightbox.astro";
import { viewFullSizeLabel } from "../lib/lightboxLabels";

const viewFullSize = viewFullSizeLabel(Astro.url.pathname);

// Shared metadata — single source of truth for <title>, description, and social cards.
const pageTitle = "Tanghīm: Arabic Maqām Tuning for any DAW";
const pageDescription =
  "A free, open-source plugin using data from the Digital Arabic Maqām Archive. Available as VST3, AU, and CLAP for macOS, Windows, and Linux.";
const siteUrl = "https://Tanghīm.app/";
const ogImage = "https://Tanghīm.app/og-image.png";
const ogImageAlt =
  "The Tanghīm plugin interface showing maqām tuning sliders on a navy panel.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- JS-gate: only hide .reveal elements when JS is running.
         Without this class, all .reveal elements remain fully visible (no-JS safe). -->
    <script is:inline>
      document.body.classList.add("js-ready");
    </script>

    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Nav />

    <main class="flex-1" id="main-content">
      <!-- ═══════════════════════════════════════════
           HERO
           ═══════════════════════════════════════════ -->
      <section
        class="page-band pt-10 pb-16 px-6 max-[600px]:pt-8 max-[600px]:pb-12 max-[600px]:px-5"
        aria-label="Introduction"
      >
        <div
          class="hero-inner max-w-[860px] mx-auto flex flex-col items-center gap-11 text-center max-[600px]:gap-8"
        >
          <!-- Text block -->
          <div class="flex flex-col items-center gap-5">
            <p
              class="m-0 text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-[var(--brand-muted)]"
            >
              Finally!
            </p>

            <h1
              class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.15] tracking-[-0.02em] text-[var(--brand-text)] max-w-[18ch] text-balance"
            >
              Over a <span class="text-[var(--brand-gold)]">thousand years</span
              > of Arabic maqām intonation at your fingertips
            </h1>

            <p
              class="m-0 text-[clamp(1rem,2.2vw,1.125rem)] leading-[1.65] text-[var(--brand-muted)] max-w-[60ch] text-balance"
            >
              <strong class="text-[var(--brand-gold)] font-bold">Tanghīm</strong
              > is a <strong class="text-[var(--brand-text)] font-semibold"
                >free, open-source MIDI plugin</strong
              > that brings historical and modern Arabic maqām tunings from the <strong
                class="text-[var(--brand-text)] font-semibold"
                >Digital Arabic Maqām Archive</strong
              > directly to <strong
                class="text-[var(--brand-text)] font-semibold">any DAW</strong
              >
            </p>

            <!-- CTAs -->
            <div
              class="flex gap-[0.875rem] flex-wrap justify-center items-center mt-1 max-[600px]:gap-[0.625rem]"
            >
              <a
                href="#download"
                class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline"
                >Download</a
              >
            </div>
          </div>

          <!-- UI screenshot with gold glow -->
          <div class="relative w-full max-w-[820px]">
            <div
              class="hero-glow absolute pointer-events-none z-0"
              aria-hidden="true"
            >
            </div>
            <button type="button" class="lightbox-trigger" data-lightbox aria-label={viewFullSize}>
              <img
                src="/tanghim-ui.png"
                alt="The Tanghīm plugin interface: a bank of tuning sliders showing maqām degrees in gold against a navy panel, with maqām selector, preset grid, and reference-frequency controls."
                class="block w-full h-auto rounded-[0.625rem] border border-[color-mix(in_srgb,var(--brand-gold)_22%,transparent)]"
                width="1756"
                height="1370"
                loading="eager"
              />
            </button>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           TRUST / CONTEXT STRIP
           ═══════════════════════════════════════════ -->
      <section
        class="page-band trust-strip reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-11 px-6"
        aria-label="Credits and licence"
      >
        <div class="colophon reveal">
          <p class="colophon-eyebrow">Credits &amp; licence</p>
          <p class="colophon-text">
            <strong class="accent">Tanghīm</strong> was conceived and designed by
            <a
              href="https://khyamallami.com/"
              class="colophon-link"
              target="_blank"
              rel="noopener noreferrer">Khyam Allami</a
            > at the <a
              href="https://musicintelligencelab.com/"
              class="colophon-link"
              target="_blank"
              rel="noopener noreferrer">Music Intelligence Lab</a
            > / <a
              href="https://www.aub.edu.lb/cams/"
              class="colophon-link"
              target="_blank"
              rel="noopener noreferrer"
              >Center for Advanced Mathematical Sciences</a
            >, American University of Beirut, Lebanon, 2026. It is free and <a
              href="https://github.com/Music-Intelligence-Lab/Tanghīm"
              class="colophon-link"
              target="_blank"
              rel="noopener noreferrer">open source</a
            >, licensed under <a
              href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
              class="colophon-link"
              target="_blank"
              rel="noopener noreferrer">CC BY-NC-SA 4.0</a
            >.
          </p>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           Showcase: Historical lineage — manuscripts → DAW (no image yet)
           ═══════════════════════════════════════════ -->
      <Showcase
        title="From the <strong>9th Century</strong> to your DAW"
        subtitle="Manuscripts of maqām theory revived."
        image="/manuscripts-collage.jpg"
        imageAlt="A collage of historical Arabic manuscripts on maqām theory, their tuning tables and diagrams laid side by side."
      >
        <p>
          The intonation of Arabic maqām has always been led by our ears, but it
          has also been theorised and measured by many great minds over the
          centuries.
        </p>
        <p>
          al-Mawṣilī, al-Kindī, al-Fārābī, Ibn Sīna, al-Urmawī, Mikhā'īl
          Meshshāqa, the Cairo Congress Tuning Committees, Amīn al-Dīk, Tawfīq
          al-Ṣabbāgh and many more…
        </p>
        <p>
          Thanks to the data provided by the <strong
            >Digital Arabic Maqām Archive (DiArMaqAr)</strong
          >, all of these systems can now be accessed and modified through <strong
            class="text-[var(--brand-gold)] font-bold">Tanghīm</strong
          > in just a couple of clicks.
        </p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           DiArMaqAr interlude — the archive is the foundation (before features)
           ═══════════════════════════════════════════ -->
      <section
        class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5"
        aria-label="What is the Digital Arabic Maqām Archive?"
      >
        <Interlude
          eyebrow="What is the Digital Arabic Maqām Archive?"
          expandable
          expandLabel="Expand"
          collapseLabel="Collapse"
        >
          <p>
            <strong class="text-[var(--brand-gold)] font-bold">Tanghīm</strong> draws
            its data from the <a
              href="https://diarmaqar.net/"
              class="interlude-link"
              target="_blank"
              rel="noopener noreferrer"
              >Digital Arabic Maqām Archive (DiArMaqAr)</a
            >, an open-source repository of historically documented tuning systems
            and maqāmāt of the Arabic-speaking region, each with full bibliographic
            attribution.
          </p>
          <p>
            Tanghīm queries DiArMaqAr's REST API and caches the data locally, so
            the maqāmāt and tunings you play are the same as the archive holds.
            An update button tells you when the archive has changed.
          </p>
          <p>
            DiArMaqAr was researched, designed, and developed by Khyam Allami
            with Ibrahim El Khansa at the Music Intelligence Lab/Center for
            Advanced Mathematical Sciences, American University of Beirut,
            Lebanon in 2026.
          </p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           Showcase: Tuning Methods — the headline capability
           (the #features anchor — nav "Features" targets it)
           ═══════════════════════════════════════════ -->
      <Showcase
        id="features"
        title="Arabic maqām tuning, <strong>your sounds</strong>"
        subtitle="Three tuning methods, from software synths to hardware."
        image="/mts-esp-plugins-collage.jpg"
        imageAlt="A collage of software synthesizers and plugins retuned by Tanghīm via MTS-ESP, MPE, and pitch bend."
      >
        <p>
          <strong class="text-[var(--brand-gold)] font-bold">Tanghīm</strong> provides
          three methods to apply Arabic maqām tuning to your instruments. MTS-ESP
          retunes compatible synths automatically and immediately from the main <strong
            >transmitter</strong
          > plugin over shared memory.
        </p>
        <p>
          For non-MTS-ESP enabled instruments, a dedicated <strong
            >receiver</strong
          > plugin enables per-note pitch bend using MPE (MIDI Polyphonic Expression),
          or Monophonic Pitch Bend for single-MIDI-channel synths.
        </p>
        <div class="badge-row">
          <Badge variant="mts">MTS-ESP</Badge>
          <Badge variant="mpe">MPE</Badge>
          <Badge variant="monopb">Mono PB</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MTS-ESP interlude — captions the tuning-methods showcase above
           ═══════════════════════════════════════════ -->
      <section
        class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5"
        aria-label="What is MTS-ESP?"
      >
        <Interlude
          eyebrow="What is MTS-ESP?"
          expandable
          expandLabel="Expand"
          collapseLabel="Collapse"
        >
          <p>
            MTS-ESP is a tuning protocol developed by <a
              href="https://github.com/ODDSound/MTS-ESP"
              class="interlude-link"
              target="_blank"
              rel="noopener noreferrer">ODDSound</a
            >. One transmitter plugin sets the tuning, and any number of
            compatible instruments connect to it automatically, retuning
            together with no manual setup. The tuning updates in real time, so a
            change of maqām or transposition is transmitted to every connected
            instrument. It also allows multiple receiver plugins to share the
            same real-time change with non-MTS-ESP software and hardware
            instruments
          </p>
        </Interlude>
      </section>

      <!-- Showcase: Slider Bank — edit by ear -->
      <Showcase
        title="Edit with your <strong>ears</strong> and play"
        subtitle="Theoretical tuning data, in practice"
        image="/shot-ears.png"
        imageAlt="The Tanghīm slider bank: twelve per-chromatic-step sliders showing cents readouts, IPN labels, solfège, and PAO names, with gold-highlighted maqām degree thumbs."
      >
        <p>
          Twelve sliders, one per chromatic step, provide a simple and immediate
          way to explore the tunings. Each slider includes snap markers to
          explore the different intervals, whilst letting you adjust any note by
          ear.
        </p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (tanghīm vs tasyīk/tashrīq) — pairs with Slider Bank above
           ═══════════════════════════════════════════ -->
      <section
        class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5"
        aria-label='The difference between tanghīm and "tasyīk" / "tashrīq"'
      >
        <Interlude
          eyebrow='What is the difference between tanghīm and "tasyīk" or "tashrīq"?'
          expandable
          expandLabel="Expand"
          collapseLabel="Collapse"
        >
          <p>
            Since the first digital Arabic keyboards of the 1980s, to this day,
            musicians of the Arabic-speaking region have relied on what is known
            locally as <em>tashrīq</em> or <em>tasyīk</em>: shifting a note from
            its natural tuning to a "quarter-tone" tuning, that is, lowering it
            by 50 cents. The process is called tasyīk or tashrīq in the sense of
            making the note a <em>sīkāh</em>, the Persian-Arabic-Ottoman name for
            the "quarter-tone" in Arabic maqām theory, or making it an "Eastern"
            note (sharqīya).
          </p>
          <p>
            But the tuning of Arabic maqām does not rest only on placing a sīkāh
            within a scale of equal-tempered notes; it rests on the full
            intonation that gives every note its precise ratio. The choice of
            tasyīk or tashrīq, to change the tuning of a single note only, came
            from the practical need to save time and effort, changing one note
            instead of many, at the cost of proper maqām intonation.
          </p>
          <p>
            Today, <strong class="text-[var(--brand-gold)] font-bold"
              >Tanghīm</strong
            > offers a fast, practical, precise, and faithful solution for the resonance
            of the music of the Arabic-speaking region. With the freedom to adjust
            any note by ear to taste and to save presets, so that choosing any maqām,
            or modulating from it, is just a click away.
          </p>
        </Interlude>
      </section>

      <!-- Showcase: Maqam Selection & Presets -->
      <Showcase
        title="Choose your maqām then <strong>modulate</strong>"
        subtitle="MIDI-mappable and automatable presets."
        image="/shot-modulate.png"
        imageAlt="The Tanghīm 4×2 preset grid with eight named maqām presets, with maqām rāst highlighted in gold as the active preset."
      >
        <p>
          Save up to eight presets of any maqām, in any available transposition,
          in any tuning, and switch between them by MIDI-mapping your
          controller, sending Program Change messages, or using DAW automation.
        </p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           Showcase: full-width Diwānayn view — the expanded two-octave layout
           ═══════════════════════════════════════════ -->
      <Showcase
        title="Dīwānayn from <strong>Yegāh to Saham</strong>"
        subtitle="Expand to full width for a two-octave view."
        image="/shot-diwanayn.png"
        imageAlt="The Tanghīm plugin expanded to full width, its slider bank laying out a tuning system across both dawāwīn from G2 to Ab4, every degree named with PAO names and solfège."
      >
        <p>
          Widen the plugin and the slider bank grows with it, laying out the
          tuning system across the two dawāwīn, the lower and upper octave
          registers of Arabic maqām theory. Every degree is visible at once,
          with its note names and solfège so you can see the whole system.
        </p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (dawāwīn) — body-only, pairs with the showcase above
           ═══════════════════════════════════════════ -->
      <section
        class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5"
        aria-label="The two dawāwīn"
      >
        <Interlude
          eyebrow="What is the Diwān of Arabic maqām theory?"
          expandable
          expandLabel="Expand"
          collapseLabel="Collapse"
        >
          <p>
            Arabic maqām theory gives unique Persian-Arab-Ottoman names for each
            of its notes (<em>rāst</em>, <em>dūgāh</em>, <em>sīkāh</em>, and so
            on) across two <span lang="ar">دواوين</span> (<em>dawāwīn</em>), a
            lower and an upper <em>dīwān</em> (octave). Expand <strong
              class="text-[var(--brand-gold)] font-bold">Tanghīm</strong
            > to its full width to see the tuning systems and maqāmāt across the two
            octaves.
          </p>
        </Interlude>
      </section>

      <!-- Showcase: Oscillator — audition instantly (Osc only) -->
      <Showcase
        title="Hear it <strong>instantly</strong>"
        subtitle="Audition any tuning with no instrument loaded."
      >
        <p>
          The built-in triangle-wave oscillator (Osc) lets you hear a tuning
          immediately, with no external instrument loaded, so you can explore a
          maqām the moment you select it.
        </p>
        <div class="badge-row">
          <Badge variant="osc">Osc</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           FEATURE ROWS (each its own alternating band)
           ═══════════════════════════════════════════ -->

      <!-- Feature: Heptatonic mode -->
      <FeatureRow
        title="Heptatonic mode for <strong>quick play</strong>"
        image="/tanghim-ui.png"
        imageAlt="The Tanghīm interface with Heptatonic mode active, the white keys remapped to play the maqām degrees in order from the tonic."
      >
        <p>
          Heptatonic mode (Hept) remaps the keyboard so every maqām is
          performable on the diatonic (white) keys alone starting from its
          associated tonic. Any maqām becomes easy to hear and play, with no
          complex fingerings to learn.
        </p>
      </FeatureRow>

      <!-- Feature: Reference frequency (reversed) -->
      <FeatureRow
        title="Set your <strong>reference pitch</strong>"
        image="/tanghim-ui.png"
        imageAlt="The Tanghīm interface showing the reference-frequency control: an arc knob with a Hz input, cents readout, and semitone-step buttons."
        reverse
      >
        <p>
          Set the tuning's reference pitch by ear, exact Hz, or cents to match
          your favourite recordings or your taste. The reference retains across
          maqāmāt and tuning systems, so you can set it and forget it.
        </p>
      </FeatureRow>

      <!-- Feature: Save & load .Tanghīm files -->
      <FeatureRow
        title="Save and load your <strong>maqām tunings</strong>"
        image="/tanghim-ui.png"
        imageAlt="The Tanghīm interface showing the Save and Load buttons and the full tuning state ready to store as a .Tanghīm file."
      >
        <p>
          Edit, save, and reload your maqām tunings and presets as
          human-readable .Tanghīm files including the reference pitch and
          per-note overrides across different octaves.
        </p>
      </FeatureRow>

      <!-- Feature: Grab the MIDI notes (reversed) -->
      <FeatureRow
        title="Grab and process the <strong>MIDI notes</strong>"
        image="/tanghim-ui.png"
        imageAlt="The full Tanghīm interface showing the MIDI drag-export button, ready to drag the current maqām's notes out as a standard MIDI file."
        reverse
      >
        <p>
          Drag the current maqām's MIDI notes out as a standard MIDI file, onto
          your timeline, or as a clip to feed arpeggiators and other MIDI
          processors. A Program Change is embedded so the preset re-arms on
          playback.
        </p>
      </FeatureRow>

      <!-- ═══════════════════════════════════════════
           ABLETON CALL-OUT
           ═══════════════════════════════════════════ -->
      <section
        class="page-band ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5"
        aria-label="Ableton Live compatibility"
      >
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2
            class="m-0 text-[clamp(1.25rem,3vw,1.625rem)] font-bold text-[var(--brand-text)] tracking-[-0.01em] text-balance"
          >
            A practical maqām tuning method for Ableton Live
          </h2>
          <p
            class="m-0 text-[1rem] leading-[1.7] text-[var(--brand-muted)] max-w-[60ch] text-pretty"
          >
            Ableton Live doesn't allow third-party MIDI-effect plug-ins. To
            solve this, <strong class="text-[var(--brand-gold)] font-bold"
              >Tanghīm</strong
            > ships with two Max for Live devices (an MPE Receiver and a Mono Pitch
            Bend Receiver) that deliver the tuning inside Live. No extra configuration,
            just install, load, and the tuning follows.
          </p>
          <div
            class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]"
          >
            <a
              href="/docs/ableton"
              class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline"
              >Ableton Live setup guide →</a
            >
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           PROBLEMS OF TUNING CALL-OUT
           ═══════════════════════════════════════════ -->
<!--      <section
        class="page-band ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5"
        aria-label="Ableton Live compatibility"
      >
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
