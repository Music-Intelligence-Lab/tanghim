---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import Badge from '../components/Badge.astro';
import Showcase from '../components/Showcase.astro';
import FeatureRow from '../components/FeatureRow.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Interlude from '../components/Interlude.astro';

// Shared metadata — single source of truth for <title>, description, and social cards.
const pageTitle = 'Tanghīm — Arabic Maqām Tuning for any DAW';
const pageDescription =
  'A free, open-source plugin using data from the Digital Arabic Maqām Archive. Available as VST3, AU, and CLAP for macOS, Windows, and Linux.';
const siteUrl = 'https://tanghim.app/';
const ogImage = 'https://tanghim.app/og-image.png';
const ogImageAlt = 'The Tanghīm plugin interface showing maqām tuning sliders on a navy panel.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- JS-gate: only hide .reveal elements when JS is running.
         Without this class, all .reveal elements remain fully visible (no-JS safe). -->
    <script is:inline>document.body.classList.add('js-ready');</script>

    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Nav />

    <main class="flex-1" id="main-content">

      <!-- ═══════════════════════════════════════════
           HERO
           ═══════════════════════════════════════════ -->
      <section class="page-band pt-10 pb-16 px-6 max-[600px]:pt-8 max-[600px]:pb-12 max-[600px]:px-5" aria-label="Introduction">
        <div class="hero-inner max-w-[860px] mx-auto flex flex-col items-center gap-11 text-center max-[600px]:gap-8">

          <!-- Text block -->
          <div class="flex flex-col items-center gap-5">
            <p class="m-0 text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-[var(--brand-muted)]">Finally!</p>

            <h1 class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.15] tracking-[-0.02em] text-[var(--brand-text)] max-w-[18ch] text-balance">
              A <span class="text-[var(--brand-gold)]">thousand years</span> of Arabic maqām intonation at your fingertips
            </h1>

            <p class="m-0 text-[clamp(1rem,2.2vw,1.125rem)] leading-[1.65] text-[var(--brand-muted)] max-w-[60ch] text-balance">
              Tanghīm is a <strong class="text-[var(--brand-text)] font-semibold">free, open-source MIDI plugin</strong> that brings historical Arabic maqām tunings from the <strong class="text-[var(--brand-text)] font-semibold">Digital Arabic Maqām Archive</strong> directly to <strong class="text-[var(--brand-text)] font-semibold">any DAW</strong>
            </p>

            <!-- CTAs -->
            <div class="flex gap-[0.875rem] flex-wrap justify-center items-center mt-1 max-[600px]:gap-[0.625rem]">
              <a href="#download" class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Download</a>
            </div>
          </div>

          <!-- UI screenshot with gold glow -->
          <div class="relative w-full max-w-[820px]">
            <div class="hero-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
            <img
              src="/tanghim-ui.png"
              alt="The Tanghīm plugin interface: a bank of tuning sliders showing maqām degrees in gold against a navy panel, with maqām selector, preset grid, and reference-frequency controls."
              class="relative z-[1] block w-full h-auto rounded-[0.625rem] border border-[color-mix(in_srgb,var(--brand-gold)_22%,transparent)]"
              width="1756"
              height="1370"
              loading="eager"
            />
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           TRUST / CONTEXT STRIP
           ═══════════════════════════════════════════ -->
      <section class="page-band trust-strip reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-11 px-6" aria-label="Origin and licence">
        <div class="colophon reveal">
          <p class="colophon-eyebrow">Origin &amp; licence</p>
          <p class="colophon-text">
            Conceived and designed by <a href="https://khyamallami.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">Khyam Allami</a> at the <a href="https://musicintelligencelab.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">Music Intelligence Lab</a> / <a href="https://www.aub.edu.lb/cams/" class="colophon-link" target="_blank" rel="noopener noreferrer">Center for Advanced Mathematical Sciences</a>, American University of Beirut, 2026. Free and <a href="https://github.com/Music-Intelligence-Lab/tanghim" class="colophon-link" target="_blank" rel="noopener noreferrer">open source</a>, licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" class="colophon-link" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>.
          </p>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           DiArMaqAr interlude — the archive is the foundation (before features)
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="What is the Digital Arabic Maqām Archive?">
        <Interlude eyebrow="What is the Digital Arabic Maqām Archive?" expandable expandLabel="Expand" collapseLabel="Collapse">
          <p>Tanghīm draws its data from the <a href="https://diarmaqar.net/" class="interlude-link" target="_blank" rel="noopener noreferrer">Digital Arabic Maqām Archive (DiArMaqAr)</a> — an open-source repository of historically documented tuning systems and maqāmāt from the music of the Arabic-speaking region, each with full bibliographic attribution.</p>
          <p>DiArMaqAr was researched, designed, and developed by Khyam Allami with Ibrahim El Khansa at the Music Intelligence Lab, American University of Beirut. Tanghīm queries its REST API and caches the data locally, so the tunings you play are the same source-attributed values the archive holds. An update button tells you when the archive has changed.</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           Showcase: Tuning Methods — the headline capability
           (the #features anchor — nav "Features" targets it)
           ═══════════════════════════════════════════ -->
      <Showcase
        id="features"
        title="Arabic maqām tuning, <strong>your sounds</strong>"
        subtitle="Three tuning methods, from software synths to hardware."
      >
        <p>MTS-ESP retunes compatible synths automatically and immediately from the main <em>transmitter</em> plugin over shared memory. Our dedicated <em>receiver</em> plugin enables per-note pitch bend using MPE (MIDI Polyphonic Expression), or Monophonic Pitch Bend for single-MIDI-channel synths.</p>
        <div class="badge-row">
          <Badge variant="mts">MTS-ESP</Badge>
          <Badge variant="mpe">MPE</Badge>
          <Badge variant="monopb">Mono PB</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MTS-ESP interlude — captions the tuning-methods showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="What is MTS-ESP?">
        <Interlude eyebrow="What is MTS-ESP?" expandable expandLabel="Expand" collapseLabel="Collapse">
          <p>MTS-ESP is a tuning protocol developed by <a href="https://github.com/ODDSound/MTS-ESP" class="interlude-link" target="_blank" rel="noopener noreferrer">ODDSound</a>. One transmitter plugin sets the tuning, and any number of compatible instruments connect to it automatically, retuning together with no manual setup. The tuning updates in real time, so a change of maqām or transposition follows every connected instrument in real time.</p>
        </Interlude>
      </section>

      <!-- Showcase: Slider Bank — edit by ear -->
      <Showcase
        title="Edit with your <strong>ears</strong> and play"
        subtitle="Theoretical tuning data, in practice"
        image="/shot-ears.png"
        imageAlt="The Tanghīm slider bank: twelve per-chromatic-step sliders showing cents readouts, IPN labels, solfège, and PAO names, with gold-highlighted maqām degree thumbs."
      >
        <p>Twelve sliders, one per chromatic step, provide a simple and immediate way to explore the tunings. Each slider includes snap markers to explore the different intervals, whilst letting you adjust any note by ear.</p>
      </Showcase>

      <!-- Showcase: Maqam Selection & Presets -->
      <Showcase
        title="Choose your maqām then <strong>modulate</strong>"
        subtitle="MIDI-mappable and automatable presets."
        image="/shot-modulate.png"
        imageAlt="The Tanghīm 4×2 preset grid with eight named maqām presets — maqām rāst highlighted in gold as the active preset."
      >
        <p>Save up to eight presets of any maqām in any available transposition, and switch between them by MIDI-mapping your controller, sending Program Change messages, or using DAW automation.</p>
      </Showcase>

      <!-- Showcase: Oscillator — audition instantly (Osc only) -->
      <Showcase
        title="Hear it <strong>instantly</strong>"
        subtitle="Audition any tuning with no instrument loaded."
      >
        <p>The built-in triangle-wave oscillator (Osc) lets you hear a tuning immediately, with no external instrument loaded — so you can explore a maqām the moment you select it.</p>
        <div class="badge-row">
          <Badge variant="osc">Osc</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           Showcase: full-width Diwānayn view — the expanded two-octave layout
           ═══════════════════════════════════════════ -->
      <Showcase
        title="Diwānayn: from <strong>Yegāh to Saham</strong>"
        subtitle="Expand to full width for a two-octave view."
        image="/shot-diwanayn.png"
        imageAlt="The Tanghīm plugin expanded to full width, its slider bank laying out a tuning system across both dawāwīn from G2 to Ab4 — every degree named with PAO names and solfège."
      >
        <p>Widen the plugin and the slider bank grows with it, laying out the tuning system across the two dawāwīn — the lower and upper octave registers of Arabic maqām theory. Every degree is visible at once, with its note names and solfège so you can see the whole system.</p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (dawāwīn) — body-only, pairs with the showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="The two dawāwīn">
        <Interlude eyebrow="What is the Diwān of Arabic maqām theory?" expandable expandLabel="Expand" collapseLabel="Collapse">
          <p>Arabic maqām theory gives unique Persian-Arab-Ottoman names for each of its notes — <em>rāst</em>, <em>dūgāh</em>, <em>sīkāh</em>, and so on — across two <span lang="ar">دواوين</span> (<em>dawāwīn</em>), a lower and an upper <em>dīwān</em> (octave). Expand Tanghīm to its full width to see the tuning systems and maqāmāt across the two octaves.</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           FEATURE ROWS (each its own alternating band)
           ═══════════════════════════════════════════ -->

      <!-- Feature: Heptatonic mode -->
      <FeatureRow
        title="Heptatonic mode for <strong>quick play</strong>"
        image="/tanghim-ui.png"
        imageAlt="The Tanghīm interface with Heptatonic mode active, the white keys remapped to play the maqām degrees in order from the tonic."
      >
        <p>Heptatonic mode (Hept) remaps the keyboard so every maqām is performable on the diatonic (white) keys alone — the white keys play the maqām degrees in order from the tonic. Any maqām becomes easy to hear and produce, with no complex fingerings to learn.</p>
      </FeatureRow>

      <!-- Feature: Reference frequency (reversed) -->
      <FeatureRow
        title="Set your <strong>reference pitch</strong>"
        image="/tanghim-ui.png"
        imageAlt="The Tanghīm interface showing the reference-frequency control — an arc knob with a Hz input, cents readout, and semitone-step buttons."
        reverse
      >
        <p>Set the tuning's reference pitch by ear, exact Hz, or cents to match your favourite recordings or your preference. The reference retains across maqāmāt and tuning systems, so you can set it and forget it.</p>
      </FeatureRow>

      <!-- Feature: Save & load .tanghim files -->
      <FeatureRow
        title="Save and load your <strong>maqām tunings</strong>"
        image="/tanghim-ui.png"
        imageAlt="The Tanghīm interface showing the Save and Load buttons and the full tuning state ready to store as a .tanghim file."
      >
        <p>Tanghīm lets you edit, save, and reload maqām tunings and preset settings as human-readable .tanghim files — including per-note overrides across different octaves.</p>
      </FeatureRow>

      <!-- Feature: Grab the MIDI notes (reversed) -->
      <FeatureRow
        title="Grab and process the <strong>MIDI notes</strong>"
        image="/tanghim-ui.png"
        imageAlt="The full Tanghīm interface showing the MIDI drag-export button, ready to drag the current maqām's notes out as a standard MIDI file."
        reverse
      >
        <p>Drag the current maqām's MIDI notes out as a standard MIDI file — onto your timeline, or as a clip to feed arpeggiators and other MIDI processors. A Program Change is embedded so the preset re-arms on playback.</p>
      </FeatureRow>

      <!-- ═══════════════════════════════════════════
           ABLETON CALL-OUT — "it even works in Live"
           ═══════════════════════════════════════════ -->
      <section class="page-band ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="Ableton Live compatibility">
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2 class="m-0 text-[clamp(1.25rem,3vw,1.625rem)] font-bold text-[var(--brand-text)] tracking-[-0.01em] text-balance">A musically meaningful maqām tuning method for Ableton Live</h2>
          <p class="m-0 text-[1rem] leading-[1.7] text-[var(--brand-muted)] max-w-[60ch] text-pretty">
            Ableton Live doesn't allow third-party MIDI-effect plug-ins. To solve this, Tanghīm ships with two Max for Live devices — an MPE Receiver and a Mono Pitch Bend Receiver — that deliver the tuning inside Live. No extra configuration: install, load, and the tuning follows.
          </p>
          <div class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]">
            <a href="/articles/cross-platform" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline">Read the article for the story →</a>
            <a href="/docs/ableton" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline">Ableton Live setup guide →</a>
          </div>
        </div>
      </section>

      <!-- Feature Grid — everything else at a glance -->
      <FeatureGrid items={[
          {
            title: 'Per-note overrides',
            body: 'Give the same note a different intonation in any octave.',
          },
          {
            title: 'Reference frequency',
            body: "Set the tuning's base pitch by knob, exact Hz, or in cents; retains across tuning systems.",
          },
          {
            title: 'Range scroller',
            body: 'Pan the 128-note keyboard with magnetic snap to C, G, and A.',
          },
          {
            title: 'DAW automation',
            body: 'Slider cents, reference offset, and preset are exposed as automatable parameters.',
          },
          {
            title: 'Save & load',
            body: 'Store and recall complete tuning states as portable .tanghim files.',
          },
          {
            title: 'Program-change switching',
            body: 'Switch presets from your DAW with MIDI Program Change messages.',
          },
        ]} />

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (name gloss) — grace note before the CTA
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="On the name">
        <Interlude eyebrow="On the name" glyph="تنغيم">
          <p><strong class="accent">Tanghīm</strong> is an Arabic <em>maṣdar</em>, or verbal noun, denoting the act of intoning or setting pitch. In linguistics it is the standard equivalent of <em>intonation</em>, the melodic contour of speech.</p>
          <p>Here it names intonational tuning — the pitch relationships that make up a system — as distinct from the Arabic usage of <span lang="ar">دوزان</span> (<em>dūzān</em>) for the mechanical tuning of an instrument's strings. Dūzān is a borrowing from Ottoman Turkish <em>düzen</em> (“order, arrangement, tuning”), from the verb <em>düzmek</em> (“to arrange, put in order”).</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           FINAL CTA BAND
           DownloadButtons anchor (#download) lives here
           ═══════════════════════════════════════════ -->
      <section class="cta-band page-band reveal border-t-2 border-[color-mix(in_srgb,var(--brand-gold)_35%,transparent)] py-20 px-6 max-[600px]:py-14 max-[600px]:px-5" aria-label="Download">
        <div class="max-w-[860px] mx-auto flex flex-col items-center gap-8 text-center">
          <h2 class="m-0 text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold text-[var(--brand-text)] tracking-[-0.02em] text-balance max-w-[24ch]">Free, open-source, and ready for your music.</h2>
          <DownloadButtons />
          <a href="/docs" class="cta-secondary inline-block mt-1 py-[0.65rem] px-4 text-[var(--brand-muted)] text-[0.9375rem] font-medium no-underline rounded-[0.375rem] border border-[color-mix(in_srgb,var(--brand-muted)_30%,transparent)] transition-[color,border-color] duration-150 ease-[ease] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Read the docs</a>
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>

<script>
  // Cross-browser scroll reveals via IntersectionObserver.
  // Requires body.js-ready (set by inline script above) — without it .reveal
  // elements are already fully visible, so no observer is needed.
  // Also skips entirely under prefers-reduced-motion (elements are visible via CSS).
  if (
    typeof IntersectionObserver !== 'undefined' &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target); // animate once only
          }
        }
      },
      { threshold: 0, rootMargin: '0px 0px -160px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    // Ensure all reveals are visible if observer unavailable or motion reduced
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  /* ── Alternating page bands ───────────────────────────────────────────
     Every top-level block in <main> carries .page-band and alternates its
     BACKGROUND TONE down the page, so background never tracks content-type —
     the info strips (colophon, name gloss, Ableton) each land on whichever
     tone their position dictates rather than being singled out. Only the base
     tone is set here; each section keeps its own gold divider border and any
     gradient wash on top (see .trust-strip / .interlude-band / .ableton-callout
     below). Two tones, delta kept subtle. */
  :global(main > .page-band) {
    position: relative;
    background-color: var(--brand-navy-900);
  }

  :global(main > .page-band:nth-child(even)) {
    background-color: color-mix(in srgb, var(--brand-navy-800) 45%, var(--brand-navy-900));
  }

  /* Gradient washes layer OVER the alternating base tone (background-image only,
     so the band's background-color still shows through). Restores the original
     per-section glows on top of the new zebra rhythm. */

  /* Trust strip / colophon — soft gold wash pooled off-centre to the right. */
  .trust-strip {
    background-image: radial-gradient(
      ellipse 45% 150% at 82% 50%,
      color-mix(in srgb, var(--brand-gold) 9%, transparent) 0%,
      transparent 70%
    );
  }

  /* Interlude / name gloss — faint radial gold wash anchoring the glyph column
     (left by default). Adjacent interludes alternate the wash side so their
     glows don't stack in the same place down the scroll. */
  .interlude-band {
    background-image: radial-gradient(
      ellipse 40% 120% at 12% 50%,
      color-mix(in srgb, var(--brand-gold) 8%, transparent) 0%,
      transparent 70%
    );
  }

  .interlude-band--right {
    background-image: radial-gradient(
      ellipse 40% 120% at 88% 50%,
      color-mix(in srgb, var(--brand-gold) 8%, transparent) 0%,
      transparent 70%
    );
  }

  /* Colophon — quiet, centred credit + licence framed like a title-page note.
     Small-caps eyebrow over the credit at small measure. Centred distinguishes
     it from the left-aligned, glyph-led interlude. */
  .colophon {
    max-width: 64ch;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .colophon-eyebrow {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--brand-gold) 85%, var(--brand-text));
  }

  .colophon-text {
    margin: 0;
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.8;
    color: color-mix(in srgb, var(--brand-muted) 82%, var(--brand-text));
    text-wrap: balance;
  }

  .colophon-link {
    color: color-mix(in srgb, var(--brand-text) 70%, var(--brand-muted));
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--brand-gold) 45%, transparent);
    text-underline-offset: 2px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .colophon-link:hover {
    color: var(--brand-text);
    text-decoration-color: var(--brand-gold);
  }

  .colophon-link:focus-visible {
    outline: 2px solid var(--brand-gold);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* CTA band bottom padding (pb-22 isn't a default Tailwind value) */
  .cta-band {
    padding-bottom: 5.5rem;
  }

  @media (max-width: 600px) {
    .cta-band {
      padding-bottom: 4rem;
    }
  }

  /* Hero glow radial gradient */
