<script>
  // Cross-browser scroll reveals via IntersectionObserver.
  // Requires body.js-ready (set by inline script above) — without it .reveal
  // elements are already fully visible, so no observer is needed.
  // Also skips entirely under prefers-reduced-motion (elements are visible via CSS).
  if (
    typeof IntersectionObserver !== 'undefined' &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target); // animate once only
          }
        }
      },
      { threshold: 0, rootMargin: '0px 0px -160px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    // Ensure all reveals are visible if observer unavailable or motion reduced
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  /* ── Alternating page bands ───────────────────────────────────────────
     Every top-level block in <main> carries .page-band and alternates its
     BACKGROUND TONE down the page, so background never tracks content-type —
     the info strips (colophon, name gloss, Ableton) each land on whichever
     tone their position dictates rather than being singled out. Only the base
     tone is set here; each section keeps its own gold divider border and any
     gradient wash on top (see .trust-strip / .interlude-band / .ableton-callout
     below). Two tones, delta kept subtle. */
  :global(main > .page-band) {
    position: relative;
    background-color: var(--brand-navy-900);
  }

  :global(main > .page-band:nth-child(even)) {
    background-color: color-mix(in srgb, var(--brand-navy-800) 45%, var(--brand-navy-900));
  }

  /* Gradient washes layer OVER the alternating base tone (background-image only,
     so the band's background-color still shows through). Restores the original
     per-section glows on top of the new zebra rhythm. */

  /* Trust strip / colophon — soft gold wash pooled off-centre to the right. */
  .trust-strip {
    background-image: radial-gradient(
      ellipse 45% 150% at 82% 50%,
      color-mix(in srgb, var(--brand-gold) 9%, transparent) 0%,
      transparent 70%
