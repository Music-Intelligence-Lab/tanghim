---
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import Badge from '../../components/Badge.astro';
import Showcase from '../../components/Showcase.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tanghīm — ضبط مقامات الموسيقى العربية لأي برنامج تسجيل</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content="Tanghīm مكوّن موسيقي مفتوح المصدر لضبط مقامات الموسيقى العربية في أي برنامج تسجيل — اختر مقاماً، اضبط كل درجة بالأذن، واضبط آلاتك عبر MTS-ESP أو MPE أو Mono Pitch Bend." />
    <link rel="canonical" href="https://tanghim.app/ar/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tanghim.app/ar/" />
    <meta property="og:title" content="Tanghīm — ضبط مقامات الموسيقى العربية لأي برنامج تسجيل" />
    <meta property="og:description" content="Tanghīm مكوّن موسيقي مفتوح المصدر لضبط مقامات الموسيقى العربية في أي برنامج تسجيل." />
    <meta property="og:image" content="https://tanghim.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="واجهة مكوّن Tanghīm تُظهر شرائح ضبط المقام على لوحة بحرية." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tanghīm — ضبط مقامات الموسيقى العربية لأي برنامج تسجيل" />
    <meta name="twitter:description" content="Tanghīm مكوّن موسيقي مفتوح المصدر لضبط مقامات الموسيقى العربية في أي برنامج تسجيل." />
    <meta name="twitter:image" content="https://tanghim.app/og-image.png" />
    <meta name="twitter:image:alt" content="واجهة مكوّن Tanghīm تُظهر شرائح ضبط المقام على لوحة بحرية." />
  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- JS-gate: only hide .reveal elements when JS is running.
         Without this class, all .reveal elements remain fully visible (no-JS safe). -->
    <script is:inline>document.body.classList.add('js-ready');</script>

    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link" lang="ar">تخطّ إلى المحتوى الرئيسي</a>

    <Nav />

    <!-- Translation-in-progress banner -->
    <div role="banner" aria-label="إشعار الترجمة" class="translation-banner bg-[var(--brand-navy-800)] border-b border-[color-mix(in_srgb,var(--brand-gold)_30%,transparent)] py-3 px-6">
      <div class="max-w-[860px] mx-auto flex items-center justify-center gap-3 flex-wrap text-center">
        <span class="text-[var(--brand-gold)] text-[0.875rem] font-semibold" lang="ar">هذه الصفحة قيد الترجمة</span>
        <span class="text-[var(--brand-muted)] text-[0.8rem]" aria-hidden="true">·</span>
        <a href="/" lang="en" class="text-[var(--brand-muted)] text-[0.875rem] no-underline transition-colors duration-150 hover:text-[var(--brand-text)] hover:underline hover:underline-offset-[2px]">View in English</a>
      </div>
    </div>

    <main class="flex-1" id="main-content">

      <!-- ═══════════════════════════════════════════
           HERO
           ═══════════════════════════════════════════ -->
      <section class="pt-20 pb-16 px-6 max-[600px]:pt-14 max-[600px]:pb-12 max-[600px]:px-5" aria-label="مقدمة">
        <div class="hero-inner max-w-[860px] mx-auto flex flex-col items-center gap-11 text-center max-[600px]:gap-8">

          <!-- Text block -->
          <div class="flex flex-col items-center gap-5">
            <p class="m-0 text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-[var(--brand-muted)]" lang="ar">ضبط مقامات الموسيقى العربية</p>

            <h1 class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.3] tracking-[-0.01em] text-[var(--brand-text)] max-w-[18ch] text-balance" lang="ar">
              عزف المقامات العربية بالـ<span class="text-[var(--brand-gold)]">نغمة</span> التي كُتبت من أجلها.
            </h1>

            <p class="m-0 text-[clamp(1rem,2.2vw,1.125rem)] leading-[1.85] text-[var(--brand-muted)] max-w-[60ch] text-balance" lang="ar">
              مكوّن مفتوح المصدر يجلب أنظمة ضبط المقامات إلى أي برنامج تسجيل — مع إمكانية ضبط كل درجة موسيقية بالأذن.
            </p>

            <!-- CTAs -->
            <div class="flex gap-[0.875rem] flex-wrap justify-center items-center mt-1 max-[600px]:gap-[0.625rem]">
              <a href="/ar/#download" class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline" lang="ar">تنزيل</a>
              <a href="/ar/docs" class="cta-secondary inline-block py-[0.65rem] px-4 text-[var(--brand-muted)] text-[0.9375rem] font-medium no-underline rounded-[0.375rem] border border-[color-mix(in_srgb,var(--brand-muted)_30%,transparent)] transition-[color,border-color] duration-150 ease-[ease] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline" lang="ar">اقرأ التوثيق</a>
            </div>
          </div>

          <!-- UI screenshot with gold glow -->
          <div class="relative w-full max-w-[820px]">
            <div class="hero-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
            <img
              src="/tanghim-ui.png"
              alt="واجهة مكوّن Tanghīm: صف شرائح الضبط يعرض درجات المقام بالذهبي على لوحة بحرية، مع منتقي المقام وشبكة الإعدادات المسبقة وعناصر تحكم التردد المرجعي."
              class="relative z-[1] block w-full h-auto rounded-[0.625rem] border border-[color-mix(in_srgb,var(--brand-gold)_22%,transparent)]"
              width="1756"
              height="1370"
              loading="eager"
            />
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           TRUST / CONTEXT STRIP
           ═══════════════════════════════════════════ -->
      <section class="trust-strip reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] pt-10 pb-12 px-6" aria-label="السياق والتوافق">
        <div class="max-w-[860px] mx-auto flex flex-col items-center gap-5 text-center">

          <!-- Origin -->
          <p class="m-0 text-[0.8rem] text-[var(--brand-muted)] tracking-[0.02em]" lang="ar">
            من تصميم وتطوير خيّام اللامي · مختبر ذكاء الموسيقى، الجامعة الأمريكية في بيروت
          </p>

          <!-- Name gloss -->
          <p class="m-0 text-[0.875rem] leading-[1.9] text-[var(--brand-muted)] max-w-[62ch] text-balance" lang="ar">
            <span class="accent">Tanghīm</span> (<span lang="ar">تنغيم</span>)
            هو مفرد <span class="accent">tanāghīm</span> (<span lang="ar">تناغيم</span>)،
            وهو طبقة أنظمة الضبط في أرشيف <a href="https://diarmaqar.net" class="text-[var(--brand-muted)] underline underline-offset-[2px] transition-colors duration-150 ease-[ease] hover:text-[var(--brand-text)] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" target="_blank" rel="noopener noreferrer">DiArMaqAr</a>.
            تعني الكلمة نظام الضبط وفعل التنغيم معاً — تنغيم مقامي لا الـ<span class="accent">دوزان</span> (<span lang="ar">دوزان</span>) الخاص بضبط وتر مفتوح.
          </p>

          <!-- Compatibility badges -->
          <div class="flex flex-col items-center gap-3 pt-1">
            <span class="text-[0.825rem] text-[var(--brand-muted)] tracking-[0.01em]" lang="ar">أي برنامج تسجيل، أي سينث — ثلاث طرق للضبط:</span>
            <div class="badge-row flex gap-2 flex-wrap justify-center">
              <Badge variant="mts">MTS-ESP</Badge>
              <Badge variant="mpe">MPE</Badge>
              <Badge variant="monopb">Mono PB</Badge>
            </div>
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           FEATURE BODY
           ═══════════════════════════════════════════ -->
      <section id="features" aria-label="الميزات">

        <!-- Showcase 1: Slider Bank -->
        <Showcase
          title="كل درجة، <strong>قابلة للتعديل</strong>."
          subtitle="بيانات الضبط نقطة انطلاق، لا قيد."
          image="/shot-sliders.png"
          imageAlt="صف شرائح Tanghīm: اثنا عشر شريحاً لكل خطوة كرماتية تعرض قراءات السنت وتسميات IPN والسولفيج وأسماء PAO، مع درجات المقام المضاءة بالذهبي."
        >
          <p lang="ar">اثنا عشر شريحاً — واحد لكل خطوة كرماتية — يحدد سنت كل درجة مقامية. يحمّل Tanghīm ضبط الأرشيف ثم يتيح لك تعديل أي درجة بالأذن؛ تصبح تعديلاتك هي مصدر الحقيقة لجدول الترددات.</p>
        </Showcase>

        <!-- Showcase 2: Tuning Methods -->
        <Showcase
          title="ضبط واحد، <strong>ثلاثة مخرجات</strong>."
          subtitle="ثلاث طرق إخراج لنطاق واسع من الآلات."
          image="/shot-methods.png"
          imageAlt="شريط التحكم العلوي في Tanghīm يعرض منتقي نظام الضبط وعقدة التردد المرجعي وشارات حالة MTS-ESP وMPE وMono PB نشطة."
        >
          <p lang="ar">يُعيد MTS-ESP ضبط السنثيسايزرات المتوافقة تلقائياً عبر الذاكرة المشتركة. يُرسل MPE انحراف نغمة لكل نوتة عبر القنوات 2–16 للآلات متعددة الأصوات. يُشغّل Mono Pitch Bend السنثيسايزرات العادية أحادية القناة. يوضح الشريط العلوي أيها نشط.</p>
          <div class="badge-row">
            <Badge variant="mts">MTS-ESP</Badge>
            <Badge variant="mpe">MPE</Badge>
            <Badge variant="monopb">Mono PB</Badge>
          </div>
        </Showcase>

        <!-- Showcase 3: Maqam Selection & Presets -->
        <Showcase
          title="اختر مقاماً، <strong>انقر</strong> السلّم."
          subtitle="ثمانية إعدادات مسبقة قابلة للربط بـ MIDI."
          image="/shot-presets.png"
          imageAlt="منتقي المقام في Tanghīm يعرض 'مقام راست' في القائمة المنسدلة وشبكة الإعدادات المسبقة 4×2 مع تمييز الفتحة الأولى بالذهبي."
        >
          <p lang="ar">اختر مقاماً وتبديلاً؛ تنجذب الشرائح إلى فواصله وتتوهج الدرجات بالذهبي. احفظ ما يصل إلى ثمانية إعدادات مسبقة وتنقّل بينها مباشرة — بما في ذلك عبر نوتة MIDI أو Program Change.</p>
        </Showcase>

        <!-- Showcase 4: Oscillator & Heptatonic mode -->
        <Showcase
          title="اسمعه <strong>فوراً</strong>."
          subtitle="استمع إلى الضبط؛ عزف السلّم على المفاتيح البيضاء."
          image="/tanghim-ui.png"
          imageAlt="الواجهة الكاملة لـ Tanghīm تعرض شارتَي Osc وHept مفعّلتين في الزاوية العلوية اليمنى."
        >
          <p lang="ar">يتيح لك المذبذب الداخلي المثلثي (Osc) سماع الضبط دون تحميل أي آلة خارجية. وضع السباعي (Hept) يُعيد توزيع لوحة المفاتيح لتعزف المفاتيح البيضاء درجات المقام بالترتيب ابتداءً من الدرجة الأساسية.</p>
          <div class="badge-row">
            <Badge variant="osc">Osc</Badge>
            <Badge variant="hept">Hept</Badge>
          </div>
        </Showcase>

        <!-- FeatureRow A: MIDI preset mapping -->
        <FeatureRow
          title="تبديل المقامات <strong>أثناء العزف</strong>."
          image="/shot-presets.png"
          imageAlt="شبكة الإعدادات المسبقة في Tanghīm تعرض ثمانية مقامات جاهزة للتبديل المباشر عبر MIDI."
        >
          <p lang="ar">اربط نوتات MIDI بالإعدادات المسبقة عبر مدخل مخصص، لتتمكن من تبديل المقامات أثناء العزف من وحدة تحكم — بشكل موثوق بغض النظر عن توجيه DAW.</p>
        </FeatureRow>

        <!-- FeatureRow B: MIDI export & .tanghim files (reversed) -->
        <FeatureRow
          title="صدّر السلّم. <strong>احفظ</strong> الإعداد."
          image="/tanghim-ui.png"
          imageAlt="واجهة Tanghīm تعرض زر سحب تصدير MIDI وحالة الضبط الكاملة جاهزة للحفظ كملف .tanghim."
          reverse
        >
          <p lang="ar">اسحب سلّم المقام الحالي كملف MIDI قياسي — مع Program Change مضمّن لإعادة تفعيل الإعداد المسبق عند التشغيل. احفظ وأعد تحميل إعدادات الضبط الكاملة كملفات .tanghim قابلة للقراءة.</p>
        </FeatureRow>

        <!-- Feature Grid -->
        <FeatureGrid items={[
          {
            title: 'تجاوزات لكل نوتة',
            body: 'أعطِ نفس فئة النغمة متغيّراً مختلفاً في أوكتاف محدد.',
          },
          {
            title: 'التردد المرجعي',
            body: 'اضبط نغمة قاعدة الضبط بعقدة أو قيمة Hz دقيقة أو بخطوات ±100 سنت؛ تنتقل عبر تبديلات النظام.',
          },
          {
            title: 'أداة التمرير',
            body: 'تصفّح لوحة المفاتيح 128 نوتة مع التثبيت المغناطيسي على C وG وA.',
          },
          {
            title: 'أتمتة DAW',
            body: 'سنت الشريحة والإزاحة المرجعية والإعداد المسبق كلها معروضة كمعاملات قابلة للأتمتة.',
          },
          {
            title: 'الحفظ والتحميل',
            body: 'خزّن واستعد حالات الضبط الكاملة كملفات .tanghim محمولة.',
          },
          {
            title: 'التبديل بـ Program Change',
            body: 'بدّل الإعدادات المسبقة من DAW برسائل MIDI Program Change.',
          },
        ]} />

      </section>

      <!-- ═══════════════════════════════════════════
           ABLETON CALL-OUT
           ═══════════════════════════════════════════ -->
      <section class="ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="التوافق مع Ableton Live">
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2 class="m-0 text-[clamp(1.25rem,3vw,1.625rem)] font-bold text-[var(--brand-text)] tracking-[-0.01em] text-balance" lang="ar">يعمل في Ableton Live أيضاً.</h2>
          <p class="m-0 text-[1rem] leading-[1.85] text-[var(--brand-muted)] max-w-[60ch] text-pretty" lang="ar">
            لا يستضيف Ableton Live مكوّنات تأثير MIDI من أطراف ثالثة، لذلك يأتي Tanghīm مزوّداً بمستقبلات Max for Live
            — مستقبل MPE ومستقبل Mono Pitch Bend — لتوصيل الضبط داخل Live.
            لا تهيئة إضافية؛ ثبّت وحمّل، والضبط يتبع.
          </p>
          <div class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]">
            <a href="/ar/articles/cross-platform" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" lang="ar">اقرأ القصة الكاملة متعددة المنصات ←</a>
            <a href="/ar/docs/ableton" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" lang="ar">دليل إعداد Ableton Live ←</a>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           FINAL CTA BAND
           DownloadButtons anchor (#download) lives here
           ═══════════════════════════════════════════ -->
      <section class="cta-band reveal border-t-2 border-[color-mix(in_srgb,var(--brand-gold)_35%,transparent)] py-20 px-6 bg-[var(--brand-navy-800)] max-[600px]:py-14 max-[600px]:px-5" aria-label="تنزيل">
        <div class="max-w-[860px] mx-auto flex flex-col items-center gap-8 text-center">
          <h2 class="m-0 text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold text-[var(--brand-text)] tracking-[-0.02em] text-balance max-w-[24ch]" lang="ar">مجاني، مفتوح المصدر، وجاهز لمقامك.</h2>
          <DownloadButtons />
          <a href="/ar/docs" class="cta-secondary inline-block mt-1 py-[0.65rem] px-4 text-[var(--brand-muted)] text-[0.9375rem] font-medium no-underline rounded-[0.375rem] border border-[color-mix(in_srgb,var(--brand-muted)_30%,transparent)] transition-[color,border-color] duration-150 ease-[ease] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline" lang="ar">اقرأ التوثيق</a>
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>

<script>
  // Cross-browser scroll reveals via IntersectionObserver.
  // Requires body.js-ready (set by inline script above) — without it .reveal
  // elements are already fully visible, so no observer is needed.
  // Also skips entirely under prefers-reduced-motion (elements are visible via CSS).
  if (
    typeof IntersectionObserver !== 'undefined' &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target); // animate once only
          }
        }
      },
      { threshold: 0, rootMargin: '0px 0px -160px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    // Ensure all reveals are visible if observer unavailable or motion reduced
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  /* Trust strip background — color-mix */
  .trust-strip {
    background-color: color-mix(in srgb, var(--brand-navy-800) 50%, var(--brand-navy-900));
  }

  /* Ableton callout background — color-mix */
  .ableton-callout {
    background-color: color-mix(in srgb, var(--brand-navy-800) 40%, var(--brand-navy-900));
  }

  /* CTA band bottom padding (pb-22 isn't a default Tailwind value) */
  .cta-band {
    padding-bottom: 5.5rem;
  }

  @media (max-width: 600px) {
    .cta-band {
      padding-bottom: 4rem;
    }
  }

  /* Hero glow radial gradient */
  .hero-glow {
    inset: -10% -8%;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      color-mix(in srgb, var(--brand-gold) 18%, transparent) 0%,
      color-mix(in srgb, var(--brand-gold) 6%, transparent) 45%,
      transparent 70%
    );
  }

  /* Hero screenshot shadow */
  .hero-glow + img {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--brand-navy-700) 60%, transparent),
      0 8px 40px rgba(0, 0, 0, 0.55),
      0 0 60px color-mix(in srgb, var(--brand-gold) 8%, transparent);
  }

  /* cta-secondary hover — border color-mix */
  .cta-secondary:hover {
    color: var(--brand-text);
    border-color: color-mix(in srgb, var(--brand-muted) 55%, transparent);
  }

  /* Hero fade/rise on load — disabled when reduced-motion preferred */
  @media (prefers-reduced-motion: no-preference) {
    .hero-inner {
      animation: hero-rise 1.1s cubic-bezier(0.33, 0, 0.2, 1) both;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(28px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

