---
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import Badge from '../../components/Badge.astro';
import Showcase from '../../components/Showcase.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Interlude from '../../components/Interlude.astro';

// Shared metadata — single source of truth for <title>, description, and social cards.
const pageTitle = 'Tanghīm — تنغيم المقام العربي لأي برنامج تسجيل';
const pageDescription =
  'إضافة مجانية ومفتوحة المصدر تعتمد بيانات الأرشيف الرقمي للمقام العربي. متوفّرة بصيغ VST3 وAU وCLAP لأنظمة macOS وWindows وLinux.';
const siteUrl = 'https://tanghim.app/ar/';
const ogImage = 'https://tanghim.app/og-image.png';
const ogImageAlt = 'واجهة إضافة Tanghīm تعرض مزالق تنغيم المقام على لوحة كحلية.';
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- JS-gate: only hide .reveal elements when JS is running.
         Without this class, all .reveal elements remain fully visible (no-JS safe). -->
    <script is:inline>document.body.classList.add('js-ready');</script>

    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link" lang="ar">تخطَّ إلى المحتوى الرئيسي</a>

    <Nav />

    <main class="flex-1" id="main-content">

      <!-- ═══════════════════════════════════════════
           HERO
           ═══════════════════════════════════════════ -->
      <section class="page-band pt-10 pb-16 px-6 max-[600px]:pt-8 max-[600px]:pb-12 max-[600px]:px-5" aria-label="مقدمة">
        <div class="hero-inner max-w-[860px] mx-auto flex flex-col items-center gap-11 text-center max-[600px]:gap-8">

          <!-- Text block -->
          <div class="flex flex-col items-center gap-5">
            <p class="m-0 text-[0.8rem] font-semibold text-[var(--brand-muted)]" lang="ar">أخيراً</p>

            <h1 class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.35] text-[var(--brand-text)] max-w-[24ch] text-balance" lang="ar">
              <span class="text-[var(--brand-gold)]">ألف عام</span> من تنغيم المقام العربي في متناول يديك
            </h1>

            <p class="m-0 text-[clamp(1rem,2.2vw,1.125rem)] leading-[1.85] text-[var(--brand-muted)] max-w-[60ch] text-balance" lang="ar">
              <span lang="en">Tanghīm</span> <strong class="text-[var(--brand-text)] font-semibold">إضافة MIDI مجانية ومفتوحة المصدر</strong> تجلب تنغيمات المقام العربي التاريخية من <strong class="text-[var(--brand-text)] font-semibold">الأرشيف الرقمي للمقام العربي</strong> مباشرةً إلى <strong class="text-[var(--brand-text)] font-semibold">أي برنامج تسجيل</strong>
            </p>

            <!-- CTAs -->
            <div class="flex gap-[0.875rem] flex-wrap justify-center items-center mt-1 max-[600px]:gap-[0.625rem]">
              <a href="#download" class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline" lang="ar">تحميل</a>
            </div>
          </div>

          <!-- UI screenshot with gold glow -->
          <div class="relative w-full max-w-[820px]">
            <div class="hero-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
            <img
              src="/tanghim-ui.png"
              alt="واجهة إضافة Tanghīm: مجموعة من مزالق التنغيم تعرض درجات المقام بالذهبي على لوحة كحلية، مع منتقي المقام وشبكة الإعدادات المسبقة وعناصر التحكم بالتردد المرجعي."
              class="relative z-[1] block w-full h-auto rounded-[0.625rem] border border-[color-mix(in_srgb,var(--brand-gold)_22%,transparent)]"
              width="1756"
              height="1370"
              loading="eager"
            />
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           TRUST / CONTEXT STRIP
           ═══════════════════════════════════════════ -->
      <section class="page-band trust-strip reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-11 px-6" aria-label="المنشأ والترخيص">
        <div class="colophon reveal">
          <p class="colophon-eyebrow" lang="ar">المنشأ والترخيص</p>
          <p class="colophon-text" lang="ar">
            من فكرة وتصميم <a href="https://khyamallami.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">خيّام اللامي</a> في <a href="https://musicintelligencelab.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">مختبر ذكاء الموسيقى</a> / <a href="https://www.aub.edu.lb/cams/" class="colophon-link" target="_blank" rel="noopener noreferrer">مركز العلوم الرياضية المتقدمة</a> بالجامعة الأمريكية في بيروت، 2026. مجاني و<a href="https://github.com/Music-Intelligence-Lab/tanghim" class="colophon-link" target="_blank" rel="noopener noreferrer">مفتوح المصدر</a>، مرخّص بموجب <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" class="colophon-link" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>.
          </p>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           DiArMaqAr interlude — the archive is the foundation (before features)
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="ما هو الأرشيف الرقمي للمقام العربي؟">
        <Interlude eyebrow="الأرشيف الرقمي للمقام العربي">
          <p>يستمد <span lang="en">Tanghīm</span> بياناته من <a href="https://diarmaqar.net/" class="interlude-link" target="_blank" rel="noopener noreferrer">الأرشيف الرقمي للمقام العربي (DiArMaqAr)</a> — وهو مستودع مفتوح المصدر لأنظمة التنغيم والمقامات الموثّقة تاريخياً من موسيقى المنطقة الناطقة بالعربية، مع توثيق مرجعي كامل لكل منها.</p>
          <p>الأرشيف من بحث وتصميم وتطوير خيّام اللامي مع إبراهيم الخنسا في مختبر ذكاء الموسيقى بالجامعة الأمريكية في بيروت. يستعلم <span lang="en">Tanghīm</span> من واجهته البرمجية (REST API) ويخزّن البيانات محلياً، فتكون النغمات التي تعزفها مطابقة للقيم الموثّقة في الأرشيف. وهناك زر تحديث يخبرك عندما يتغيّر الأرشيف.</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           Showcase: Tuning Methods — the headline capability
           (the #features anchor — nav "Features" targets it)
           ═══════════════════════════════════════════ -->
      <Showcase
        id="features"
        title="تنغيم المقام العربي، <strong>بأصواتك أنت</strong>"
        subtitle="ثلاث طرق للتنغيم، من السينثات البرمجية إلى الأجهزة."
      >
        <p lang="ar">يضبط <span lang="en">MTS-ESP</span> السينثات المتوافقة تلقائياً وفوراً من إضافة <em>الإرسال</em> الرئيسية عبر الذاكرة المشتركة. وتتيح إضافة <em>الاستقبال</em> المخصّصة ثني النغمة لكل نوتة على حدة عبر <span lang="en">MPE</span> (تعبير MIDI متعدد الأصوات)، أو ثني النغمة الأحادي للسينثات ذات قناة MIDI واحدة.</p>
        <div class="badge-row">
          <Badge variant="mts">MTS-ESP</Badge>
          <Badge variant="mpe">MPE</Badge>
          <Badge variant="monopb">Mono PB</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MTS-ESP interlude — captions the tuning-methods showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="ما هو MTS-ESP؟">
        <Interlude eyebrow="ما هو MTS-ESP؟">
          <p><span lang="en">MTS-ESP</span> بروتوكول تنغيم طوّرته شركة <a href="https://github.com/ODDSound/MTS-ESP" class="interlude-link" target="_blank" rel="noopener noreferrer">ODDSound</a>. تضبط إضافة إرسال واحدة التنغيم، فيتصل بها أي عدد من الآلات المتوافقة تلقائياً، ويُعاد تنغيمها معاً دون أي إعداد يدوي. ويتحدّث التنغيم لحظياً، فيسري تغيير المقام أو التبديل على كل آلة متصلة أثناء العزف.</p>
        </Interlude>
      </section>

      <!-- Showcase: Slider Bank — edit by ear -->
      <Showcase
        title="عدّل بـ<strong>أذنيك</strong> واعزف"
        subtitle="بيانات تنغيم نظرية، في التطبيق العملي"
        image="/shot-ears.png"
        imageAlt="مجموعة مزالق Tanghīm: اثنا عشر مزلاقاً لكل خطوة كروماتية تعرض قراءات السنت وتسميات IPN والسولفيج وأسماء PAO، مع إبهامات درجات المقام المميّزة بالذهبي."
      >
        <p lang="ar">اثنا عشر مزلاقاً، واحد لكل خطوة كروماتية، يمنحك طريقة بسيطة وفورية لاستكشاف أنظمة التنغيم. ويتضمّن كل مزلاق نقاط انجذاب لاستكشاف الأبعاد المختلفة، مع إمكانية ضبط أي نغمة بأذنك.</p>
      </Showcase>

      <!-- Showcase: Maqam Selection & Presets -->
      <Showcase
        title="اختر مقامك ثم <strong>انتقِل</strong>"
        subtitle="إعدادات مسبقة قابلة للربط بـ MIDI وللأتمتة"
        image="/shot-modulate.png"
        imageAlt="شبكة إعدادات Tanghīm المسبقة 4×2 بثمانية إعدادات مقامية مسمّاة — مقام راست مميّز بالذهبي بوصفه الإعداد النشط."
      >
        <p lang="ar">احفظ حتى ثمانية إعدادات مسبقة لأي مقام في أي تبديل متاح، وانتقل بينها عبر ربط وحدة التحكم بـ MIDI، أو بإرسال رسائل Program Change، أو باستخدام أتمتة الـ DAW.</p>
      </Showcase>

      <!-- Showcase: Oscillator — audition instantly (Osc only) -->
      <Showcase
        title="اسمعه <strong>فوراً</strong>"
        subtitle="استمع إلى أي تنغيم دون الحاجة إلى أي آلة"
      >
        <p lang="ar">يتيح لك المذبذب الداخلي ذو الموجة المثلثية (Osc) سماع التنغيم فوراً، دون الحاجة إلى أي آلة خارجية — فتستكشف المقام لحظة اختياره.</p>
        <div class="badge-row">
          <Badge variant="osc">Osc</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           Showcase: full-width Diwānayn view — the expanded two-octave layout
           ═══════════════════════════════════════════ -->
      <Showcase
        title="الديوانان: من <strong>يكاه إلى سهام</strong>"
        subtitle="وسّع الإضافة إلى العرض الكامل لرؤية الديوانين"
        image="/shot-diwanayn.png"
        imageAlt="إضافة Tanghīm موسّعة إلى العرض الكامل، ومجموعة مزالقها تنشر نظام تنغيم عبر الديوانين من G2 إلى Ab4 — كل درجة مسمّاة بأسماء PAO والسولفيج."
      >
        <p lang="ar">وسّع الإضافة فتكبر معها مجموعة المزالق، لتعرض نظام التنغيم عبر الديوانين — الأوكتاف الأدنى والأعلى في نظرية المقام العربي. تظهر كل درجة دفعة واحدة، مع أسماء نغماتها وسولفيجها، فترى النظام كاملاً.</p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (dawāwīn) — body-only, pairs with the showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="الديوانان">
        <Interlude eyebrow="ديوان نظرية المقام العربي">
          <p>تمنح نظرية المقام العربي كل نغمة اسماً فارسياً-عربياً-عثمانياً فريداً — <span lang="ar">راست</span>، <span lang="ar">دوكاه</span>، <span lang="ar">سيكاه</span>، وهكذا — عبر <span lang="ar">ديوانين</span>: ديوان أدنى وديوان أعلى (أوكتاف). وسّع <span lang="en">Tanghīm</span> إلى عرضه الكامل لترى أنظمة التنغيم والمقامات عبر الأوكتافين.</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           FEATURE ROWS (each its own alternating band)
           ═══════════════════════════════════════════ -->

      <!-- Feature: Heptatonic mode -->
      <FeatureRow
        title="الوضع السباعي <strong>للعزف السريع</strong>"
        image="/tanghim-ui.png"
        imageAlt="واجهة Tanghīm والوضع السباعي مفعّل، وقد أُعيد توزيع المفاتيح البيضاء لتعزف درجات المقام بالترتيب من درجة الأساس."
      >
        <p lang="ar">يعيد الوضع السباعي (Hept) توزيع لوحة المفاتيح ليصبح كل مقام قابلاً للعزف على المفاتيح البيضاء (الدياتونية) وحدها — فتعزف المفاتيح البيضاء درجات المقام بالترتيب من درجة الأساس. وهكذا يصبح أي مقام سهل السماع والعزف، دون مواضع أصابع معقّدة.</p>
      </FeatureRow>

      <!-- Feature: Reference frequency (reversed) -->
      <FeatureRow
        title="اضبط <strong>النغمة المرجعية</strong>"
        image="/tanghim-ui.png"
        imageAlt="واجهة Tanghīm تعرض عنصر التحكم بالتردد المرجعي — مقبض قوسي مع إدخال Hz، وقراءة بالسنت، وأزرار بخطوة نصف نغمة."
        reverse
      >
        <p lang="ar">اضبط النغمة المرجعية للتنغيم بالأذن، أو بقيمة Hz دقيقة، أو بالسنت، لتطابق تسجيلاتك المفضّلة أو ذوقك الخاص. وتبقى النغمة المرجعية ثابتة عبر المقامات وأنظمة التنغيم، فتضبطها مرة وتنساها.</p>
      </FeatureRow>

      <!-- Feature: Save & load .tanghim files -->
      <FeatureRow
        title="احفظ واسترجع <strong>تنغيمات مقاماتك</strong>"
        image="/tanghim-ui.png"
        imageAlt="واجهة Tanghīm تعرض زرَّي الحفظ والتحميل وحالة التنغيم الكاملة جاهزة للتخزين كملف .tanghim."
      >
        <p lang="ar">يتيح لك <span lang="en">Tanghīm</span> تعديل تنغيمات المقامات وإعداداتها المسبقة وحفظها وإعادة فتحها كملفات ‎.tanghim‎ سهلة القراءة — بما في ذلك تجاوزات كل نوتة عبر الأوكتافات المختلفة.</p>
      </FeatureRow>

      <!-- Feature: Grab the MIDI notes (reversed) -->
      <FeatureRow
        title="خذ <strong>نوتات MIDI</strong> وعالِجها"
        image="/tanghim-ui.png"
        imageAlt="واجهة Tanghīm الكاملة تعرض زر سحب تصدير MIDI، جاهزاً لسحب نوتات المقام الحالي كملف MIDI قياسي."
        reverse
      >
        <p lang="ar">اسحب نوتات MIDI للمقام الحالي كملف MIDI قياسي — إلى مسارك الزمني، أو كمقطع يغذّي مولّدات الأربيجيو وغيرها من معالجات MIDI. وتُضمَّن رسالة Program Change ليُعاد تفعيل الإعداد المسبق عند التشغيل.</p>
      </FeatureRow>

      <!-- ═══════════════════════════════════════════
           ABLETON CALL-OUT — "it even works in Live"
           ═══════════════════════════════════════════ -->
      <section class="page-band ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="التوافق مع Ableton Live">
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2 class="m-0 text-[clamp(1.25rem,3vw,1.625rem)] font-bold text-[var(--brand-text)] text-balance" lang="ar">طريقة تنغيم مقامي ذات معنى موسيقي في Ableton Live</h2>
          <p class="m-0 text-[1rem] leading-[1.85] text-[var(--brand-muted)] max-w-[60ch] text-pretty" lang="ar">
            لا يسمح Ableton Live بإضافات مؤثّرات MIDI من جهات خارجية. ولحل ذلك، يأتي <span lang="en">Tanghīm</span> مع جهازَي Max for Live — مستقبل MPE ومستقبل Mono Pitch Bend — يوصلان التنغيم داخل Live. دون أي إعداد إضافي: ثبّت الجهاز وأضِفه، فيتبع التنغيم.
          </p>
          <div class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]">
            <a href="/ar/articles/cross-platform" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" lang="ar">اقرأ المقال لمعرفة القصة ←</a>
            <a href="/ar/docs/ableton" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" lang="ar">دليل إعداد Ableton Live ←</a>
          </div>
        </div>
      </section>

      <!-- Feature Grid — everything else at a glance -->
      <FeatureGrid items={[
          {
            title: 'تجاوزات لكل نوتة',
            body: 'امنح النغمة نفسها تنغيماً مختلفاً في أي أوكتاف.',
          },
          {
            title: 'التردد المرجعي',
            body: 'اضبط نغمة أساس التنغيم بالمقبض، أو بقيمة Hz دقيقة، أو بالسنت؛ وتبقى ثابتة عبر أنظمة التنغيم.',
          },
          {
            title: 'أداة التمرير',
            body: 'حرّك لوحة المفاتيح ذات الـ 128 نوتة مع انجذاب مغناطيسي إلى C وG وA.',
          },
          {
            title: 'أتمتة الـ DAW',
            body: 'سنتات المزالق والإزاحة المرجعية والإعداد المسبق، جميعها معروضة كمعاملات قابلة للأتمتة.',
          },
          {
            title: 'الحفظ والاسترجاع',
            body: 'خزّن واسترجع حالات التنغيم الكاملة كملفات ‎.tanghim‎ محمولة.',
          },
          {
            title: 'التبديل بـ Program Change',
