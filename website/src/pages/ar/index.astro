---
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import Badge from '../../components/Badge.astro';
import Showcase from '../../components/Showcase.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Interlude from '../../components/Interlude.astro';

// Shared metadata — single source of truth for <title>, description, and social cards.
const pageTitle = 'تنغيم — ضبط المقامات العربية لأي محطة عمل صوتيات رقمية';
const pageDescription =
  'إضافة توسيعية (بلاجِن) مجانية ومفتوحة المصدر تعتمد بيانات أرشيف المقام العربي الرقمي. متوفّرة بصيغ VST3 وAU وCLAP لأنظمة macOS وWindows وLinux.';
const siteUrl = 'https://tanghim.app/ar/';
const ogImage = 'https://tanghim.app/og-image.png';
const ogImageAlt = 'واجهة إضافة تنغيم تعرض مزالق التنغيم على لوحة كحلية.';
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- JS-gate: only hide .reveal elements when JS is running.
         Without this class, all .reveal elements remain fully visible (no-JS safe). -->
    <script is:inline>document.body.classList.add('js-ready');</script>

    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link" lang="ar">الانتقال إلى المحتوى الرئيسي</a>

    <Nav />

    <main class="flex-1" id="main-content">

      <!-- ═══════════════════════════════════════════
           HERO  (type intentionally NOT bumped — see global.css note)
           ═══════════════════════════════════════════ -->
      <section class="page-band pt-10 pb-16 px-6 max-[600px]:pt-8 max-[600px]:pb-12 max-[600px]:px-5" aria-label="مقدمة">
        <div class="hero-inner max-w-[860px] mx-auto flex flex-col items-center gap-11 text-center max-[600px]:gap-8">

          <!-- Text block -->
          <div class="flex flex-col items-center gap-5">
            <p class="m-0 text-[0.95rem] font-semibold text-[var(--brand-muted)]" lang="ar">أخيراً</p>

            <h1 class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.35] text-[var(--brand-text)] max-w-[24ch] text-balance" lang="ar">
              <span class="text-[var(--brand-gold)]">ألف عام</span> من تنغيم المقام العربي بين يديك
            </h1>

            <p class="m-0 text-[clamp(1rem,2.2vw,1.125rem)] leading-[1.85] text-[var(--brand-muted)] max-w-[60ch] text-balance" lang="ar">
              <span class="brand-name">تنغيم</span> هي <strong class="text-[var(--brand-text)] font-semibold">إضافة توسيعية (بلاجِن) مجانية ومفتوحة المصدر</strong> تجلب تناغيم المقامات العربية التاريخية من <strong class="text-[var(--brand-text)] font-semibold">أرشيف المقام العربي الرقمي</strong> مباشرةً إلى <strong class="text-[var(--brand-text)] font-semibold">أي محطة عمل صوتيات رقمية</strong> (Digital Audio Workstation)
            </p>

            <!-- CTAs -->
            <div class="flex gap-[0.875rem] flex-wrap justify-center items-center mt-1 max-[600px]:gap-[0.625rem]">
              <a href="#download" class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline" lang="ar">تحميل</a>
            </div>
          </div>

          <!-- UI screenshot with gold glow -->
          <div class="relative w-full max-w-[820px]">
            <div class="hero-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
            <img
              src="/tanghim-ui.png"
              alt="واجهة إضافة تنغيم: مزالق التنغيم تعرض درجات المقام بالذهبي على لوحة كحلية، مع منتقي المقام وشبكة الإعدادات المسبقة وعناصر التحكم بالتردد المرجعي."
              class="relative z-[1] block w-full h-auto rounded-[0.625rem] border border-[color-mix(in_srgb,var(--brand-gold)_22%,transparent)]"
              width="1756"
              height="1370"
              loading="eager"
            />
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           TRUST / CONTEXT STRIP
           ═══════════════════════════════════════════ -->
      <section class="page-band trust-strip reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-11 px-6" aria-label="المنشأ والترخيص">
        <div class="colophon reveal">
          <p class="colophon-eyebrow" lang="ar">المنشأ والترخيص</p>
          <p class="colophon-text" lang="ar">
            <span class="brand-name">تنغيم</span> فكرة وتصميم <a href="https://khyamallami.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">خيّام اللامي</a> في <a href="https://musicintelligencelab.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">مختبر الذكاء الموسيقي</a> / <a href="https://www.aub.edu.lb/cams/" class="colophon-link" target="_blank" rel="noopener noreferrer">مركز العلوم الرياضية المتقدمة</a> بالجامعة الأمريكية في بيروت، 2026. وهي مجانية و<a href="https://github.com/Music-Intelligence-Lab/tanghim" class="colophon-link" target="_blank" rel="noopener noreferrer">مفتوحة المصدر</a>، ومرخّصة بموجب <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" class="colophon-link" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>.
          </p>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           DiArMaqAr interlude — the archive is the foundation (before features)
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="ما هو أرشيف المقام العربي الرقمي؟">
        <Interlude eyebrow="ما هو أرشيف المقام العربي الرقمي؟">
          <p>تأخذ <span class="brand-name">تنغيم</span> بياناتها من <a href="https://diarmaqar.net/" class="interlude-link" target="_blank" rel="noopener noreferrer">أرشيف المقام العربي الرقمي (DiArMaqAr)</a> — وهو أرشيف مفتوح المصدر يجمع أنظمة التنغيم والمقامات الموثّقة تاريخياً في موسيقى المنطقة الناطقة بالعربية، مع توثيق مصدر كل منها.</p>
          <p>الأرشيف من بحث وتصميم وتطوير خيّام اللامي مع إبراهيم الخنسا في مختبر الذكاء الموسيقي بالجامعة الأمريكية في بيروت. تتّصل <span class="brand-name">تنغيم</span> بواجهة الأرشيف البرمجية (REST API) وتحفظ نسخة من بياناته على جهازك، لتكون النغمات المعزوفة مطابقة تماماً لِما في الأرشيف. ويُنبّهك زر التحديث كلما تغيّر الأرشيف.</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           Showcase: Tuning Methods — the headline capability (#features anchor)
           ═══════════════════════════════════════════ -->
      <Showcase
        id="features"
        title="تنغيم المقام العربي، <strong>بأصواتك</strong>"
        subtitle="ثلاث طرق للتنغيم، من السنثسيزرات المبرمجة إلى الصلبة."
      >
        <p lang="ar">يضبط <span lang="en">MTS-ESP</span> السنثسيزرات المتوافقة تلقائياً وفوراً من إضافة <em>الإرسال</em> الرئيسية عبر الذاكرة المشتركة. وتتيح إضافة <em>الاستقبال</em> المخصّصة ثني النغمة (Pitch Bend) لكل نوتة عبر MPE (MIDI Polyphonic Expression)، أو ثني النغمة الأحادي (Mono Pitch Bend) للسنثسيزرات ذات قناة MIDI واحدة.</p>
        <div class="badge-row">
          <Badge variant="mts">MTS-ESP</Badge>
          <Badge variant="mpe">MPE</Badge>
          <Badge variant="monopb">Mono PB</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MTS-ESP interlude — captions the tuning-methods showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="ما هو MTS-ESP؟">
        <Interlude eyebrow="ما هو MTS-ESP؟">
          <p><span lang="en">MTS-ESP</span> بروتوكول تنغيم من تطوير شركة <a href="https://github.com/ODDSound/MTS-ESP" class="interlude-link" target="_blank" rel="noopener noreferrer">ODDSound</a>. تُرسِل إضافةٌ توسيعية أساسية واحدة التنغيمَ إلى الآلات المبرمجة المتوافقة تلقائياً، ويُعاد تنغيمها دون أي إعداد يدوي. يُحدَّث التنغيم لحظياً، فيسري تغيير المقام أو التصوير على كل آلة متصلة في الوقت الفعلي.</p>
        </Interlude>
      </section>

      <!-- Showcase: Slider Bank — edit by ear -->
      <Showcase
        title="عدّلوا <strong>سماعياً</strong> واعزفوا"
        subtitle="بيانات التنغيم النظرية، عملياً"
        image="/shot-ears.png"
        imageAlt="مزالق تنغيم: اثنا عشر مزلاقاً لكل نغمة لونية تعرض قراءات السنت وتسميات IPN والسولفيج وأسماء PAO، مع درجات المقام المميّزة بالذهبي."
      >
        <p lang="ar">اثنا عشر مزلاقاً، واحد لكل نغمة لونية (كروماتيكية)، تفتح أنظمة التنغيم أمامكم ببساطة فورية. ويسمح كل مزلاق باستكشاف أبعاد التنغيم المختلفة، عبر نقاط الانجذاب أو ضبط أي نغمة سماعياً.</p>
      </Showcase>

      <!-- Showcase: Maqam Selection & Presets -->
      <Showcase
        title="اختاروا مقامكم <strong>وانتقلوا</strong>"
        subtitle="إعدادات مسبقة قابلة للربط بـ MIDI وللأتمتة"
        image="/shot-modulate.png"
        imageAlt="شبكة إعدادات تنغيم المسبقة 4×2 بثمانية إعدادات مقامية مسمّاة — مقام راست مميّز بالذهبي بوصفه الإعداد النشط."
      >
        <p lang="ar">تتيح لكم <span class="brand-name">تنغيم</span> حفظ حتى ثمانية إعدادات مسبقة لأي مقام في أي تصوير متاح، والتبديل بينها أثناء العزف: بربط وحدة التحكم بـ MIDI، أو بإرسال رسائل Program Change، أو بأتمتة محطة عمل الصوتيات الرقمية.</p>
      </Showcase>

      <!-- Showcase: Oscillator — audition instantly (Osc only) -->
      <Showcase
        title="اسمعوه <strong>فوراً</strong>"
        subtitle="الاستماع إلى أي تنغيم دون الحاجة إلى أي آلة"
      >
        <p lang="ar">يتيح لكم المذبذب الداخلي ذو الموجة المثلثية (Osc) سماع أي تنغيم فوراً دون أي آلة خارجية — فتستكشفون المقام لحظة اختياره.</p>
        <div class="badge-row">
          <Badge variant="osc">Osc</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           Showcase: full-width Diwānayn view — the expanded two-octave layout
           ═══════════════════════════════════════════ -->
      <Showcase
        title="الديوانان: من <strong>يكاه إلى سهم</strong>"
        subtitle="توسيع الإضافة إلى العرض الكامل لرؤية الديوانين"
        image="/shot-diwanayn.png"
        imageAlt="إضافة تنغيم موسّعة إلى العرض الكامل، ومجموعة مزالقها تعرض نظام تنغيم عبر الديوانين من G2 إلى Ab4 — كل درجة مسمّاة بأسماء PAO والسولفيج."
      >
        <p lang="ar">بتوسيع الإضافة تكبر معها مجموعة المزالق، فتعرض نظام التنغيم عبر الديوانين — الأوكتاف الأدنى والأعلى في نظرية المقام العربي. وتظهر كل درجة دفعة واحدة بأسماء نغماتها وسولفيجها، لتروا النظام كاملاً أمامكم.</p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (dawāwīn) — body-only, pairs with the showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="الديوانان">
        <Interlude eyebrow="ديوان نظرية المقام العربي">
          <p>تمنح نظرية المقام العربي كل نغمة اسماً فارسياً-عربياً-عثمانياً فريداً — <span lang="ar">راست</span>، <span lang="ar">دوكاه</span>، <span lang="ar">سيكاه</span>، وهكذا — عبر <span lang="ar">ديوانين</span>: ديوان أدنى وأعلى (أوكتاف). وبتوسيع <span class="brand-name">تنغيم</span> إلى عرضها الكامل تظهر أنظمة التنغيم والمقامات عبر الأوكتافين.</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           FEATURE ROWS (each its own alternating band)
           ═══════════════════════════════════════════ -->

      <!-- Feature: Heptatonic mode -->
      <FeatureRow
        title="الوضع السباعي <strong>للعزف السريع</strong>"
        image="/tanghim-ui.png"
        imageAlt="واجهة تنغيم والوضع السباعي مفعّل، وقد أُعيد توزيع المفاتيح البيضاء لتعزف درجات المقام بالترتيب من درجة استقرار المقام."
      >
        <p lang="ar">يعيد الوضع السباعي (Hept) توزيع لوحة المفاتيح ليصبح كل مقام قابلاً للعزف على المفاتيح البيضاء (الدياتونية) وحدها. فتوزّع درجات المقام عليها بالترتيب من درجة استقرار المقام، ويصبح عزف وسماع أي مقام سهلاً للمبتدئين دون مواضع أصابع معقّدة.</p>
      </FeatureRow>

      <!-- Feature: Reference frequency (reversed) -->
      <FeatureRow
        title="اضبطوا <strong>نغمتكم المرجعية</strong>"
        image="/tanghim-ui.png"
        imageAlt="واجهة تنغيم تعرض عنصر التحكم بالتردد المرجعي — مقبض قوسي مع إدخال Hz، وقراءة بالسنت، وأزرار بخطوة نصف بعد."
        reverse
      >
        <p lang="ar">اضبطوا النغمة المرجعية للتنغيم بالأذن، أو بقيمة Hz دقيقة، أو بالسنت، لتطابق تسجيلاتكم المفضّلة أو ذوقكم. وتبقى ثابتة عبر المقامات وأنظمة التنغيم، فاضبطوها مرة وانسوها.</p>
      </FeatureRow>

      <!-- Feature: Save & load .tanghim files -->
      <FeatureRow
        title="احفظوا واسترجعوا <strong>تناغيم مقاماتكم</strong>"
        image="/tanghim-ui.png"
        imageAlt="واجهة تنغيم تعرض زرَّي الحفظ والاسترجاع وحالة التنغيم الكاملة جاهزة للتخزين كملف .tanghim."
      >
        <p lang="ar">تتيح لكم <span class="brand-name">تنغيم</span> تعديل تناغيم المقامات وإعداداتها المسبقة وحفظها وإعادة فتحها كملفات ‎.tanghim‎ سهلة القراءة — بما فيها تجاوزات كل نوتة عبر الأوكتافات المختلفة.</p>
      </FeatureRow>

      <!-- Feature: Grab the MIDI notes (reversed) -->
      <FeatureRow
        title="التقطوا <strong>نوتات MIDI</strong> وعالجوها"
        image="/tanghim-ui.png"
        imageAlt="واجهة تنغيم الكاملة تعرض زر سحب تصدير MIDI، جاهزاً لسحب نوتات المقام الحالي كملف MIDI قياسي."
        reverse
      >
        <p lang="ar">اسحبوا نوتات MIDI للمقام الحالي كملف MIDI قياسي — إلى مساركم الزمني، أو كمقطع يغذّي مولّدات الأربيجيو وغيرها من معالجات MIDI. وتُضمَّن رسالة Program Change ليُعاد تفعيل الإعداد المسبق عند التشغيل.</p>
      </FeatureRow>

      <!-- ═══════════════════════════════════════════
           ABLETON CALL-OUT — "it even works in Live"
           ═══════════════════════════════════════════ -->
      <section class="page-band ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="التوافق مع Ableton Live">
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2 class="m-0 text-[clamp(1.5rem,3.2vw,1.9rem)] font-bold text-[var(--brand-text)] text-balance" lang="ar">طريقة تنغيم مقامي ذات معنى موسيقي في Ableton Live</h2>
          <p class="m-0 text-[1.1rem] leading-[1.9] text-[var(--brand-muted)] max-w-[60ch] text-pretty" lang="ar">
            لا يسمح Ableton Live بإضافات مؤثّرات MIDI من جهات خارجية. لذا تأتي <span class="brand-name">تنغيم</span> بجهازَي Max for Live — مستقبل MPE ومستقبل Mono Pitch Bend — يوصّلان التنغيم داخل Live. دون أي إعداد إضافي: ثبّتوا الجهاز وأضيفوه، فيسري التنغيم تلقائياً.
          </p>
          <div class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]">
            <a href="/ar/articles/cross-platform" class="text-[0.95rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" lang="ar">قراءة المقال لمعرفة القصة ←</a>
            <a href="/ar/docs/ableton" class="text-[0.95rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline" lang="ar">دليل إعداد Ableton Live ←</a>
          </div>
        </div>
      </section>

      <!-- Feature Grid — everything else at a glance -->
      <FeatureGrid items={[
          {
            title: 'تجاوزات لكل نوتة',
            body: 'لكل نوتة تنغيم مختلف في أي أوكتاف.',
          },
          {
            title: 'التردد المرجعي',
            body: 'ضبط النغمة المرجعية بالمقبض، أو بقيمة Hz دقيقة، أو بالسنت؛ وتثبت عبر أنظمة التنغيم.',
          },
          {
            title: 'أداة التمرير',
            body: 'تمرير لوحة المفاتيح ذات الـ 128 نوتة مع انجذاب مغناطيسي إلى C وG وA.',
          },
          {
            title: 'أتمتة محطة عمل الصوتيات الرقمية',
