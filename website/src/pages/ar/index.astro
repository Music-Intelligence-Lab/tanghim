<script>
  // Cross-browser scroll reveals via IntersectionObserver.
  // Requires body.js-ready (set by inline script above) — without it .reveal
  // elements are already fully visible, so no observer is needed.
  // Also skips entirely under prefers-reduced-motion (elements are visible via CSS).
  if (
    typeof IntersectionObserver !== 'undefined' &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target); // animate once only
          }
        }
      },
      { threshold: 0, rootMargin: '0px 0px -160px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    // Ensure all reveals are visible if observer unavailable or motion reduced
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
  }
</script>

