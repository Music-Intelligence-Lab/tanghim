---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 — Tanghīm</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <script is:inline>document.body.classList.add('js-ready');</script>
    <Nav />

    <main class="flex-1 flex flex-col items-center justify-center py-24 px-6 text-center" id="main-content">
      <div class="flex flex-col items-center gap-6 max-w-[480px]">

        <p class="m-0 text-[clamp(4rem,14vw,7rem)] font-bold leading-none tracking-[-0.04em] text-[var(--brand-gold)]" aria-label="404">404</p>

        <h1 class="m-0 text-[clamp(1.125rem,3vw,1.5rem)] font-semibold text-[var(--brand-text)] tracking-[-0.01em] text-balance leading-[1.3]">
          This page doesn't exist — or hasn't been tuned yet.
        </h1>

        <p class="m-0 text-[0.9375rem] leading-[1.7] text-[var(--brand-muted)] text-balance">
          You may have followed an old link or mistyped the address.
        </p>

        <div class="flex gap-3 flex-wrap justify-center mt-2">
          <a
            href="/"
            class="inline-block py-[0.65rem] px-6 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline"
          >Home</a>
          <a
            href="/docs"
            class="inline-block py-[0.65rem] px-6 text-[var(--brand-muted)] text-[0.9375rem] font-medium no-underline rounded-[0.375rem] border border-[color-mix(in_srgb,var(--brand-muted)_30%,transparent)] transition-[color,border-color] duration-150 ease-[ease] hover:text-[var(--brand-text)] hover:border-[color-mix(in_srgb,var(--brand-muted)_55%,transparent)] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline"
          >Docs</a>
        </div>

      </div>
    </main>

    <Footer />
  </body>
</html>
