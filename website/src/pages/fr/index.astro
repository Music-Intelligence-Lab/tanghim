---
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import Badge from '../../components/Badge.astro';
import Showcase from '../../components/Showcase.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Interlude from '../../components/Interlude.astro';
import Lightbox from '../../components/Lightbox.astro';
import { viewFullSizeLabel } from '../../lib/lightboxLabels';

const viewFullSize = viewFullSizeLabel(Astro.url.pathname);

// Shared metadata — single source of truth for <title>, description, and social cards.
const pageTitle = 'Tanghīm : accordage du maqām arabe pour toute STAN';
const pageDescription =
  'Un greffon libre et open source qui exploite les données du Digital Arabic Maqām Archive. Disponible en VST3, AU et CLAP pour macOS, Windows et Linux.';
const siteUrl = 'https://tanghim.app/fr/';
const ogImage = 'https://tanghim.app/og-image.png';
const ogImageAlt = "L'interface du greffon Tanghīm montrant les curseurs d'accordage du maqām sur un panneau bleu nuit.";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- JS-gate: only hide .reveal elements when JS is running.
         Without this class, all .reveal elements remain fully visible (no-JS safe). -->
    <script is:inline>document.body.classList.add('js-ready');</script>

    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <Nav />

    <main class="flex-1" id="main-content">

      <!-- ═══════════════════════════════════════════
           HERO
           ═══════════════════════════════════════════ -->
      <section class="page-band pt-10 pb-16 px-6 max-[600px]:pt-8 max-[600px]:pb-12 max-[600px]:px-5" aria-label="Introduction">
        <div class="hero-inner max-w-[860px] mx-auto flex flex-col items-center gap-11 text-center max-[600px]:gap-8">

          <!-- Text block -->
          <div class="flex flex-col items-center gap-5">
            <p class="m-0 text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-[var(--brand-muted)]">Enfin&#8239;!</p>

            <h1 class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.15] tracking-[-0.02em] text-[var(--brand-text)] max-w-[20ch] text-balance">
              Plus de <span class="text-[var(--brand-gold)]">mille ans</span> d'intonation du maqām arabe au bout des doigts
            </h1>

            <p class="m-0 text-[clamp(1rem,2.2vw,1.125rem)] leading-[1.65] text-[var(--brand-muted)] max-w-[60ch] text-balance">
              Tanghīm est un <strong class="text-[var(--brand-text)] font-semibold">greffon MIDI libre et open source</strong> qui apporte les accordages historiques et modernes du maqām arabe issus du <strong class="text-[var(--brand-text)] font-semibold">Digital Arabic Maqām Archive</strong> directement dans <strong class="text-[var(--brand-text)] font-semibold">n'importe quelle STAN</strong>
            </p>

            <!-- CTAs -->
            <div class="flex gap-[0.875rem] flex-wrap justify-center items-center mt-1 max-[600px]:gap-[0.625rem]">
              <a href="#download" class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Télécharger</a>
            </div>
          </div>

          <!-- UI screenshot with gold glow -->
          <div class="relative w-full max-w-[820px]">
            <div class="hero-glow absolute pointer-events-none z-0" aria-hidden="true"></div>
            <button type="button" class="lightbox-trigger" data-lightbox aria-label={viewFullSize}>
              <img
                src="/tanghim-ui.png"
                alt="L'interface du greffon Tanghīm : un banc de curseurs d'accordage affichant les degrés du maqām en doré sur un panneau bleu nuit, avec le sélecteur de maqām, la grille de préréglages et les commandes de fréquence de référence."
                class="block w-full h-auto rounded-[0.625rem] border border-[color-mix(in_srgb,var(--brand-gold)_22%,transparent)]"
                width="1756"
                height="1370"
                loading="eager"
              />
            </button>
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           TRUST / CONTEXT STRIP
           ═══════════════════════════════════════════ -->
      <section class="page-band trust-strip reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-11 px-6" aria-label="Crédits et licence">
        <div class="colophon reveal">
          <p class="colophon-eyebrow">Crédits &amp; licence</p>
          <p class="colophon-text">
            Imaginé et conçu par <a href="https://khyamallami.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">Khyam Allami</a> au <a href="https://musicintelligencelab.com/" class="colophon-link" target="_blank" rel="noopener noreferrer">Music Intelligence Lab</a> / <a href="https://www.aub.edu.lb/cams/" class="colophon-link" target="_blank" rel="noopener noreferrer">Center for Advanced Mathematical Sciences</a>, Université américaine de Beyrouth, Liban, 2026. Libre et <a href="https://github.com/Music-Intelligence-Lab/tanghim" class="colophon-link" target="_blank" rel="noopener noreferrer">open source</a>, sous licence <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" class="colophon-link" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>.
          </p>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           Showcase: Historical lineage — manuscripts → DAW (no image yet)
           ═══════════════════════════════════════════ -->
      <Showcase
        title="Du <strong>9ᵉ siècle</strong> à votre STAN"
        subtitle="Les manuscrits de la théorie du maqām, ressuscités."
      >
        <p>L'intonation du maqām arabe a toujours été guidée par nos oreilles, mais elle a aussi été théorisée et mesurée par de nombreux grands esprits au fil des siècles.</p>
        <p>al-Mawṣilī, al-Kindī, al-Fārābī, Ibn Sīna, al-Urmawī, Mikhā'īl Meshshāqa, les commissions d'accordage du Congrès du Caire, Amīn al-Dīk, Tawfīq al-Ṣabbāgh, et bien d'autres…</p>
        <p>Grâce aux données fournies par le <strong>Digital Arabic Maqām Archive (DiArMaqAr)</strong>, tous ces systèmes peuvent désormais être consultés et modifiés dans Tanghīm en quelques clics.</p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           DiArMaqAr interlude — the archive is the foundation (before features)
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5" aria-label="Qu'est-ce que le Digital Arabic Maqām Archive&#8239;?">
        <Interlude eyebrow="Qu'est-ce que le Digital Arabic Maqām Archive ?" expandable expandLabel="Développer" collapseLabel="Réduire">
          <p>Tanghīm puise ses données dans le <a href="https://diarmaqar.net/" class="interlude-link" target="_blank" rel="noopener noreferrer">Digital Arabic Maqām Archive (DiArMaqAr)</a>, un dépôt open source de systèmes d'accordage et de maqāmāt historiquement documentés, issus de la musique de la région arabophone, chacun avec une attribution bibliographique complète.</p>
          <p>Tanghīm interroge l'API REST du DiArMaqAr et met les données en cache localement&#8239;: les maqāmāt et les accordages que vous jouez sont donc les mêmes que ceux de l'archive. Un bouton de mise à jour vous signale quand l'archive a changé.</p>
          <p>Le DiArMaqAr a été recherché, conçu et développé par Khyam Allami avec Ibrahim El Khansa au Music Intelligence Lab / Center for Advanced Mathematical Sciences de l'Université américaine de Beyrouth, au Liban, en 2026.</p>
        </Interlude>
      </section>

      <!-- ═══════════════════════════════════════════
           Showcase: Tuning Methods — the headline capability
           (the #features anchor — nav "Features" targets it)
           ═══════════════════════════════════════════ -->
      <Showcase
        id="features"
        title="L'accordage du maqām arabe, <strong>vos sons</strong>"
        subtitle="Trois méthodes d'accordage, du synthé logiciel au matériel."
      >
        <p>Tanghīm propose trois méthodes pour appliquer l'accordage du maqām arabe à vos instruments. MTS-ESP réaccorde automatiquement et instantanément les synthés compatibles depuis le greffon <em>émetteur</em> principal, via la mémoire partagée.</p>
        <p>Pour les instruments non compatibles MTS-ESP, un greffon <em>récepteur</em> dédié permet le pitch bend par note grâce au MPE (MIDI Polyphonic Expression), ou le pitch bend monophonique pour les synthés à canal MIDI unique.</p>
        <div class="badge-row">
          <Badge variant="mts">MTS-ESP</Badge>
          <Badge variant="mpe">MPE</Badge>
          <Badge variant="monopb">Mono PB</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MTS-ESP interlude — captions the tuning-methods showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5" aria-label="Qu'est-ce que MTS-ESP&#8239;?">
        <Interlude eyebrow="Qu'est-ce que MTS-ESP ?" expandable expandLabel="Développer" collapseLabel="Réduire">
          <p>MTS-ESP est un protocole d'accordage développé par <a href="https://github.com/ODDSound/MTS-ESP" class="interlude-link" target="_blank" rel="noopener noreferrer">ODDSound</a>. Un seul greffon émetteur définit l'accordage, et n'importe quel nombre d'instruments compatibles s'y connectent automatiquement, se réaccordant ensemble sans aucune configuration manuelle. L'accordage se met à jour en temps réel&#8239;: un changement de maqām ou de transposition est transmis à chaque instrument connecté. Le protocole permet aussi à plusieurs greffons récepteurs de partager ce même changement en temps réel avec des instruments logiciels et matériels non compatibles MTS-ESP.</p>
        </Interlude>
      </section>

      <!-- Showcase: Slider Bank — edit by ear -->
      <Showcase
        title="Réglez à l'<strong>oreille</strong> et jouez"
        subtitle="Des données d'accordage théoriques, en pratique"
        image="/shot-ears.png"
        imageAlt="Le banc de curseurs de Tanghīm : douze curseurs, un par degré chromatique, affichant les valeurs en cents, les libellés IPN, le solfège et les noms PAO, avec les degrés du maqām surlignés en doré."
      >
        <p>Douze curseurs, un par degré chromatique, offrent un moyen simple et immédiat d'explorer les accordages. Chaque curseur comporte des repères d'aimantation pour explorer les différents intervalles, tout en vous laissant régler chaque note à l'oreille.</p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (tanghīm vs tasyīk/tashrīq) — pairs with Slider Bank above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5" aria-label="La différence entre l'accordage et le « tasyīk » / « tashrīq »">
        <Interlude eyebrow="Quelle est la différence entre le tanghīm et le « tasyīk » ou « tashrīq » ?" expandable expandLabel="Développer" collapseLabel="Réduire">
          <p>Depuis les premiers claviers arabes numériques des années 1980, et jusqu'à aujourd'hui, les musiciens de la région arabophone s'appuient sur ce qu'on appelle localement le <em>tashrīq</em> ou le <em>tasyīk</em>&#8239;: déplacer une note de son accordage naturel vers un accordage «&#8239;quart de ton&#8239;», c'est-à-dire l'abaisser de 50 cents. Le procédé est nommé tasyīk ou tashrīq au sens de rendre la note un <em>sīkāh</em>, le nom perso-arabo-ottoman du «&#8239;quart de ton&#8239;» dans la théorie du maqām arabe, ou d'en faire une note «&#8239;orientale&#8239;» (<em>sharqīya</em>).</p>
          <p>Mais l'accordage du maqām arabe ne repose pas seulement sur la présence d'un sīkāh au sein d'une gamme de notes tempérées&#8239;; il repose sur l'intonation complète qui donne à chaque note son rapport précis. Le choix du tasyīk ou du tashrīq, ne changer l'accordage que d'une seule note, est né du besoin pratique de gagner du temps et de l'effort, en changeant une note plutôt que plusieurs, au prix d'une intonation correcte du maqām.</p>
          <p>Aujourd'hui, <strong class="text-[var(--brand-gold)] font-bold">Tanghīm</strong> offre une solution rapide, pratique, précise et fidèle à la sonorité de la musique de la région arabophone. Avec la liberté de régler n'importe quelle note à l'oreille selon votre goût et d'enregistrer des préréglages, de sorte que choisir un maqām, ou en moduler, ne soit qu'à un clic.</p>
        </Interlude>
      </section>

      <!-- Showcase: Maqam Selection & Presets -->
      <Showcase
        title="Choisissez votre maqām puis <strong>modulez</strong>"
        subtitle="Des préréglages mappables en MIDI et automatisables."
        image="/shot-modulate.png"
        imageAlt="La grille de préréglages 4×2 de Tanghīm avec huit préréglages de maqām nommés, le maqām rāst surligné en doré comme préréglage actif."
      >
        <p>Enregistrez jusqu'à huit préréglages de n'importe quel maqām, dans n'importe quelle transposition disponible, dans n'importe quel accordage, et passez de l'un à l'autre en mappant votre contrôleur en MIDI, en envoyant des messages Program Change, ou via l'automation de la STAN.</p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           Showcase: full-width Diwānayn view — the expanded two-octave layout
           ═══════════════════════════════════════════ -->
      <Showcase
        title="Diwānayn&#8239;: de <strong>Yegāh à Saham</strong>"
        subtitle="Élargissez à pleine largeur pour une vue sur deux octaves."
        image="/shot-diwanayn.png"
        imageAlt="Le greffon Tanghīm élargi à pleine largeur, son banc de curseurs déployant un système d'accordage sur les deux dawāwīn, de G2 à Ab4, chaque degré nommé avec les noms PAO et le solfège."
      >
        <p>Élargissez le greffon et le banc de curseurs grandit avec lui, déployant le système d'accordage sur les deux dawāwīn, les registres d'octave inférieur et supérieur de la théorie du maqām arabe. Chaque degré est visible d'un coup, avec ses noms de notes et son solfège, pour voir le système entier.</p>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           MUSICOLOGY STRIP (dawāwīn) — body-only, pairs with the showcase above
           ═══════════════════════════════════════════ -->
      <section class="page-band interlude-band interlude-band--right reveal border-t border-[color-mix(in_srgb,var(--brand-gold)_14%,transparent)] py-8 px-6 max-[600px]:py-6 max-[600px]:px-5" aria-label="Les deux dawāwīn">
        <Interlude eyebrow="Qu'est-ce que le dīwān de la théorie du maqām arabe ?" expandable expandLabel="Développer" collapseLabel="Réduire">
          <p>La théorie du maqām arabe donne à chacune de ses notes un nom perso-arabo-ottoman unique (<em>rāst</em>, <em>dūgāh</em>, <em>sīkāh</em>, et ainsi de suite), répartis sur deux <span lang="ar">دواوين</span> (<em>dawāwīn</em>), un <em>dīwān</em> inférieur et un supérieur (octave). Élargissez Tanghīm à pleine largeur pour voir les systèmes d'accordage et les maqāmāt sur les deux octaves.</p>
        </Interlude>
      </section>

      <!-- Showcase: Oscillator — audition instantly (Osc only) -->
      <Showcase
        title="Écoutez-le <strong>instantanément</strong>"
        subtitle="Auditionnez n'importe quel accordage sans charger d'instrument."
      >
        <p>L'oscillateur intégré à onde triangulaire (Osc) vous permet d'entendre un accordage immédiatement, sans charger le moindre instrument externe, vous pouvez ainsi explorer un maqām dès que vous le sélectionnez.</p>
        <div class="badge-row">
          <Badge variant="osc">Osc</Badge>
        </div>
      </Showcase>

      <!-- ═══════════════════════════════════════════
           FEATURE ROWS (each its own alternating band)
           ═══════════════════════════════════════════ -->

      <!-- Feature: Heptatonic mode -->
      <FeatureRow
        title="Le mode heptatonique pour <strong>jouer vite</strong>"
        image="/tanghim-ui.png"
        imageAlt="L'interface de Tanghīm avec le mode heptatonique actif, les touches blanches réagencées pour jouer les degrés du maqām dans l'ordre à partir de la tonique."
      >
        <p>Le mode heptatonique (Hept) réagence le clavier pour que chaque maqām soit jouable sur les seules touches diatoniques (blanches) : les touches blanches jouent les degrés du maqām dans l'ordre, à partir de la tonique. N'importe quel maqām devient facile à entendre et à produire, sans doigtés complexes à apprendre.</p>
      </FeatureRow>

      <!-- Feature: Reference frequency (reversed) -->
      <FeatureRow
        title="Réglez votre <strong>hauteur de référence</strong>"
        image="/tanghim-ui.png"
        imageAlt="L'interface de Tanghīm montrant la commande de fréquence de référence : un bouton en arc avec une saisie en Hz, un affichage en cents et des boutons par demi-ton."
        reverse
      >
        <p>Réglez la hauteur de référence de l'accordage à l'oreille, en Hz précis ou en cents, pour correspondre à vos enregistrements préférés ou à votre goût. La référence est conservée d'un maqām et d'un système d'accordage à l'autre&#8239;: réglez-la une fois et oubliez-la.</p>
      </FeatureRow>

      <!-- Feature: Save & load .tanghim files -->
      <FeatureRow
        title="Enregistrez et rechargez vos <strong>accordages de maqām</strong>"
        image="/tanghim-ui.png"
        imageAlt="L'interface de Tanghīm montrant les boutons Enregistrer et Charger, et l'état d'accordage complet prêt à être stocké dans un fichier .tanghim."
      >
        <p>Tanghīm vous laisse modifier, enregistrer et recharger les accordages de maqām et les préréglages sous forme de fichiers .tanghim lisibles, y compris les redéfinitions par note d'une octave à l'autre.</p>
      </FeatureRow>

      <!-- Feature: Grab the MIDI notes (reversed) -->
      <FeatureRow
        title="Récupérez et traitez les <strong>notes MIDI</strong>"
        image="/tanghim-ui.png"
        imageAlt="L'interface complète de Tanghīm montrant le bouton d'export MIDI par glisser, prêt à faire glisser les notes du maqām courant sous forme de fichier MIDI standard."
        reverse
      >
        <p>Glissez les notes MIDI du maqām courant sous forme de fichier MIDI standard, sur votre timeline, ou comme clip pour alimenter des arpégiateurs et d'autres processeurs MIDI. Un message Program Change est intégré pour que le préréglage se réactive à la lecture.</p>
      </FeatureRow>

      <!-- ═══════════════════════════════════════════
           ABLETON CALL-OUT — "it even works in Live"
           ═══════════════════════════════════════════ -->
      <section class="page-band ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="Compatibilité Ableton Live">
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2 class="m-0 text-[clamp(1.25rem,3vw,1.625rem)] font-bold text-[var(--brand-text)] tracking-[-0.01em] text-balance">Une méthode d'accordage du maqām musicalement pertinente pour Ableton Live</h2>
          <p class="m-0 text-[1rem] leading-[1.7] text-[var(--brand-muted)] max-w-[60ch] text-pretty">
            Ableton Live n'autorise pas les greffons d'effet MIDI tiers. Pour y remédier, Tanghīm est livré avec deux périphériques Max for Live (un récepteur MPE et un récepteur Mono Pitch Bend) qui acheminent l'accordage à l'intérieur de Live. Aucune configuration supplémentaire&#8239;: installez, chargez, et l'accordage suit.
          </p>
          <div class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]">
            <a href="/fr/docs/ableton" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline">Guide de configuration Ableton Live →</a>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           PROBLEMS OF TUNING CALL-OUT
           ═══════════════════════════════════════════ -->
<!--      <section class="page-band ableton-callout reveal border-t border-[color-mix(in_srgb,var(--brand-muted)_12%,transparent)] py-16 px-6 max-[600px]:py-12 max-[600px]:px-5" aria-label="Compatibilité Ableton Live">
        <div class="max-w-[680px] mx-auto flex flex-col gap-4">
          <h2 class="m-0 text-[clamp(1.25rem,3vw,1.625rem)] font-bold text-[var(--brand-text)] tracking-[-0.01em] text-balance">Les problèmes de l'accordage dans la production musicale moderne</h2>
          <p class="m-0 text-[1rem] leading-[1.7] text-[var(--brand-muted)] max-w-[60ch] text-pretty">
            Depuis les années 1980, de nombreux artistes, musiciens et chercheurs tentent de trouver des méthodes pour faire entrer les systèmes d'accordage musicaux des cultures du monde dans notre paysage technologique, analogique et numérique. À ce jour, l'industrie des technologies musicales ne s'est toujours pas accordée sur une méthode permettant aux cultures musicales du monde d'exister au sein des flux de production sonore de façon musicale et signifiante.
          </p>
          <div class="flex flex-col gap-[0.375rem] pt-1 max-[600px]:gap-[0.625rem]">
            <a href="/fr/articles/cross-platform" class="text-[0.9rem] text-[var(--brand-gold)] no-underline transition-opacity duration-150 ease-[ease] hover:opacity-80 hover:underline hover:underline-offset-[2px] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[2px] focus-visible:rounded-[2px] focus-visible:outline">Lisez l'article pour toute l'histoire →</a>
          </div>
        </div>
      </section>
