---
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tanghīm — Français (bientôt)</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Tanghīm — greffon d'accordage maqam arabe pour toute STAN. La version française est en cours de préparation." />
    <link rel="canonical" href="https://tanghim.app/fr/" />
  </head>
  <body class="bg-[var(--brand-navy-900)] min-h-screen flex flex-col">
    <!-- Skip to main content (keyboard users) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Nav />

    <!-- Translation-in-progress banner -->
    <div role="banner" aria-label="Avis de traduction" class="translation-banner bg-[var(--brand-navy-800)] border-b border-[color-mix(in_srgb,var(--brand-gold)_30%,transparent)] py-3 px-6">
      <div class="max-w-[860px] mx-auto flex items-center justify-center gap-3 flex-wrap text-center">
        <span class="text-[var(--brand-gold)] text-[0.875rem] font-semibold">Cette page est en cours de traduction</span>
        <span class="text-[var(--brand-muted)] text-[0.8rem]" aria-hidden="true">·</span>
        <a href="/" lang="en" class="text-[var(--brand-muted)] text-[0.875rem] no-underline transition-colors duration-150 hover:text-[var(--brand-text)] hover:underline hover:underline-offset-[2px]">Voir en anglais</a>
      </div>
    </div>

    <main class="flex-1 flex flex-col items-center justify-center py-20 px-6 max-[600px]:py-14 max-[600px]:px-5" id="main-content">

      <div class="flex flex-col items-center gap-8 text-center max-w-[540px]">

        <!-- Wordmark -->
        <p class="m-0 text-[clamp(2.5rem,6vw,4rem)] font-bold tracking-[-0.02em] text-[var(--brand-text)] accent" aria-label="Tanghīm">
          Tangh<span class="text-[var(--brand-gold)]">ī</span>m
        </p>

        <!-- Coming-soon message -->
        <p class="m-0 text-[1rem] leading-[1.8] text-[var(--brand-muted)]">
          La version française du site est en cours de préparation.<br />
          En attendant, vous pouvez consulter le site en anglais ou télécharger le greffon directement.
        </p>

        <!-- Actions -->
        <div class="flex gap-3 flex-wrap justify-center">
          <a href="/#download" class="inline-block py-[0.65rem] px-7 bg-[var(--brand-gold)] text-[var(--brand-navy-900)] text-[0.9375rem] font-bold rounded-[0.375rem] no-underline transition-[opacity,transform] duration-150 ease-[ease] hover:opacity-[0.88] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Télécharger</a>
          <a href="/" class="inline-block py-[0.65rem] px-4 text-[var(--brand-muted)] text-[0.9375rem] font-medium no-underline rounded-[0.375rem] border border-[color-mix(in_srgb,var(--brand-muted)_30%,transparent)] transition-[color,border-color] duration-150 ease-[ease] hover:text-[var(--brand-text)] focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline">Site anglais →</a>
        </div>

      </div>

    </main>

    <Footer />
  </body>
</html>
