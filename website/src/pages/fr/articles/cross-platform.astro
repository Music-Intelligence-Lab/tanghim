---
import '../../../styles/global.css';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Formats de greffons, effets MIDI et compatibilité — Tanghīm (bientôt)</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Article sur les formats de greffons audio, les effets MIDI et la prise en charge des STAN — la version française est en cours de traduction." />
    <link rel="canonical" href="https://tanghim.app/fr/articles/cross-platform" />
  </head>
  <body class="bg-[var(--brand-navy-900)] text-[var(--brand-text)] min-h-screen flex flex-col">
    <Nav />

    <!-- Translation-in-progress banner -->
    <div role="banner" aria-label="Avis de traduction" class="translation-banner bg-[var(--brand-navy-800)] border-b border-[color-mix(in_srgb,var(--brand-gold)_30%,transparent)] py-3 px-6">
      <div class="max-w-[75ch] mx-auto flex items-center justify-center gap-3 flex-wrap text-center">
        <span class="text-[var(--brand-gold)] text-[0.875rem] font-semibold">Cet article est en cours de traduction</span>
        <span class="text-[var(--brand-muted)] text-[0.8rem]" aria-hidden="true">·</span>
        <a href="/articles/cross-platform" lang="en" class="text-[var(--brand-muted)] text-[0.875rem] no-underline transition-colors duration-150 hover:text-[var(--brand-text)] hover:underline hover:underline-offset-[2px]">Lire en anglais</a>
      </div>
    </div>

    <main class="flex-1 py-10 px-6 pb-20 max-[640px]:py-6 max-[640px]:px-4 max-[640px]:pb-16">

      <!-- Back link -->
      <div class="max-w-[75ch] mx-auto mb-8 flex items-center gap-2 text-[0.875rem]">
        <a href="/fr/" class="text-[var(--brand-muted)] no-underline transition-colors duration-150 hover:text-[var(--brand-gold)]">← Tanghīm</a>
      </div>

      <article class="max-w-[75ch] mx-auto leading-[1.75] text-[1.0625rem] max-[640px]:text-[1rem]">

        <header class="mb-12 pb-8 border-b border-[color-mix(in_srgb,var(--brand-gold)_15%,transparent)]">
          <h1 class="text-[clamp(1.5rem,4vw,2.25rem)] font-bold leading-[1.2] text-[var(--brand-text)] m-0 mb-5 tracking-[-0.02em] max-[640px]:text-[1.5rem]">
            Formats de greffons, effets MIDI et compatibilité avec les STAN
          </h1>
          <p class="text-[1.0625rem] text-[var(--brand-muted)] leading-[1.75] m-0">
            La traduction française de cet article est en cours de préparation. En attendant,
            vous pouvez <a href="/articles/cross-platform" lang="en" class="text-[var(--brand-gold)] no-underline hover:underline hover:underline-offset-[2px]">lire l'article en anglais</a>.
          </p>
        </header>

        <div class="flex flex-col items-center gap-6 py-8 text-center text-[var(--brand-muted)]">
          <p class="m-0 text-[1rem] leading-[1.8]">
            Cet article explique pourquoi Tanghīm fonctionne différemment dans Logic Pro et Ableton Live :
            les contraintes de format de greffon, les différences de routage MIDI,
            et pourquoi le chemin Ableton passe par Max for Live plutôt qu'un VST3.
          </p>
          <a
            href="/articles/cross-platform"
            lang="en"
            class="inline-block py-[0.65rem] px-6 border border-[color-mix(in_srgb,var(--brand-gold)_40%,transparent)] text-[var(--brand-gold)] text-[0.9375rem] font-medium rounded-[0.375rem] no-underline transition-[color,border-color,opacity] duration-150 ease-[ease] hover:opacity-80 focus-visible:outline-2 focus-visible:outline-[var(--brand-gold)] focus-visible:outline-offset-[3px] focus-visible:outline"
          >Lire l'article complet en anglais →</a>
        </div>

      </article>
    </main>

    <Footer />
  </body>
</html>
